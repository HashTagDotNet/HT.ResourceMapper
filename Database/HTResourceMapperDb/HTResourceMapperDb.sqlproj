<Project>
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>HTResourceMapperDb</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <ProjectGuid>{3d5ce90e-8f6e-41f1-93f0-f04a394dbb88}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude duplicate files left from previous SDK attempt -->
    <Build Remove="HTResourceMapper\**" />
    <!-- Exclude seed/demo data scripts — not schema objects -->
    <Build Remove="Scripts\**" />
    <!-- Exclude build output -->
    <Build Remove="bin\**" />
    <None Include="Scripts\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>
</Project>