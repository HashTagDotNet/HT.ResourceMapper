<Project Sdk="Microsoft.Build.Sql/2.2.0">
  <PropertyGroup>
    <Name>HTResourceMapperDb</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <ProjectGuid>{3d5ce90e-8f6e-41f1-93f0-f04a394dbb88}</ProjectGuid>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Build Include="Security\*.sql" />
    <Build Include="Stored Procedures\*.sql" />
    <Build Include="Tables\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scripts\**" />
    <Folder Include="Scripts\" />
    <Folder Include="Security\" />
    <Folder Include="Stored Procedures\" />
    <Folder Include="Tables\" />
  </ItemGroup>
</Project>
