@page "/"
@using ResourceMapper.Common.Shared.HomePage

<PageTitle>Resource Mapper - Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudGrid>
        <!-- Search Card -->
        <MudItem xs="12">
            @* <MudPaper Elevation="2" Style="height: fit-content;" Class="d-flex" > *@
            <div class="d-flex justify-center">
                <div class="d-flex flex-none">
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddResource" Size="Size.Small" />

                </div>
                <div class="d-flex flex-none">
                    <MudTextField @bind-Value="SearchTerm"
                                  Label="Search resources..."
                                  Variant="Variant.Filled"
                                  @onkeypress="HandleKeyPress" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search" />
                </div>
                @* <MudCardContent>
                    <MudTextField @bind-Value="SearchTerm" 
                                  Label="Search resources..." 
                                  Variant="Variant.Filled"
                                  @onkeypress="HandleKeyPress" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search" />
                </MudCardContent>
                <MudCardActions Class="justify-space-between">
                    <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Search" OnClick="PerformSearch" Size="Size.Small"></MudFab>
                   
                 *@
            </div>
        </MudItem>

        <!-- Data Grid Card -->
        <MudItem xs="12">
            <MudCard Elevation="2" Style="height: 70vh; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="Icons.Material.Filled.TableChart" Class="mr-3" />
                            Resources
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex: 1; overflow: hidden;">
                    <MudDataGrid @ref="dataGrid"
                                 T="ResourceGridItemModel"
                                 VirtualizeServerData="LoadServerData"
                                 Virtualize="true"
                                 Height="500px"
                                 Elevation="0"
                                 Bordered="true"
                                 Dense="true"
                                 Hover="false"
                                 Striped="false"
                                 SortMode="SortMode.Single"
                                 Filterable="false"
                                 ShowMenuIcon="false"
                                 FixedHeader="true"
                                 ItemSize="50"
                                 RowsPerPage="5"
                                 CurrentPage="0">

                        <Columns>
                            <TemplateColumn Title="Resource Name" Sortable="true" Tag="@nameof(ResourceGridItemModel.ResourceName)">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                        @context.Item.ResourceName
                                    </MudText>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Resource Type" Sortable="false">
                                <CellTemplate>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Text">
                                        @(context.Item.ResourceType ?? "Unknown")
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Tags" Sortable="false">
                                <CellTemplate>
                                    <div style="white-space: pre-line; font-size: 0.875rem; line-height: 1.2;">
                                        @if (context.Item.Tags?.Any() == true)
                                        {
                                            var displayTags = context.Item.Tags.Take(3).ToList();
                                            @foreach (var tag in displayTags)
                                            {
                                                <div>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                        @($"{tag.TagKey}: {tag.TagValue}")
                                                    </MudChip>
                                                </div>
                                            }
                                            @if (context.Item.Tags.Count > 3)
                                            {
                                                <div style="font-style: italic; color: var(--mud-palette-text-secondary);">
                                                    (@(context.Item.Tags.Count - 3) more...)
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Style="font-style: italic;">No tags</MudText>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Last Updated" Sortable="false">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">
                                        @context.Item.RelativeLastUpdatedOn
                                    </MudText>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>

                        <NoRecordsContent>
                            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">
                                No resources found
                            </MudText>
                        </NoRecordsContent>

                        <LoadingContent>
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </LoadingContent>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
