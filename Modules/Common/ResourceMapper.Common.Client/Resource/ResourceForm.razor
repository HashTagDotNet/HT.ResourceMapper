@page "/resource/{ResourceUid?}"
@using MudBlazor

@if (!_isInitialized)
{
    return;
}

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
    <!-- Fixed Header -->
    <MudAppBar Color="Color.Surface" Elevation="1" Class="mud-width-full">
        <MudText Typo="Typo.h6" Class="ml-3">Resource: My Resource Name</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mr-2" OnClick="OnApplyClicked">Apply</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mr-2" OnClick="OnDeleteClicked">Delete</MudButton>
        <MudIconButton Icon="Icons.Material.Filled.Close" Color="Color.Default" />
    </MudAppBar>

    <!-- Main Layout -->
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-0" Style="height: calc(100vh - 64px);">
        <MudGrid Class="mud-height-full">
            <!-- Left Navigation Panel -->
            <MudItem xs="3" Class="pa-0">
                <MudPaper Class="mud-height-full" Elevation="1" Square="true">
                    <MudList T="string" Clickable="true" Class="py-0">
                        <MudListItem T="string" Text="Resource Properties" Icon="Icons.Material.Filled.Settings" />
                        <MudListItem T="string" Text="Search Tags" Icon="Icons.Material.Filled.Tag" />
                        <MudListItem T="string" Text="Depends On" Icon="Icons.Material.Filled.CallMade" />
                        <MudListItem T="string" Text="Dependent On" Icon="Icons.Material.Filled.CallReceived" />
                    </MudList>
                </MudPaper>
            </MudItem>

            <!-- Main Content Area -->
            <MudItem xs="9" Class="pa-4">


                <MudForm @ref="editorForm"
                         Model="@_editorModel"
                         @bind-IsValid="@_success"
                         Disabled="@_isDisabled">

                    <MudTextField T="string"
                                  @bind-Value="_editorModel.Code"
                                  Label="Code"
                                  For="@(()=>_editorModel.Code)"
                                  Required="true"
                                  RequiredError="You must provide at least a code for this resource"
                                  Validation="@ValidateCode"></MudTextField>

                    <MudTextField T="string"
                                  @bind-Value="_editorModel.Name"
                                  Label="Name"></MudTextField>
                    <MudSelect T="string" @bind-Value="_editorModel.ResourceType" Label="Resource Type" Required="true" RequiredError="Every resource must be associated with a specific resource type">
                        <MudSelectItem T="string" Value="@("None")">None</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Application")">Application</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Service Bus")">Service Bus</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Database")">Database</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Storage Account")">Storage Account</MudSelectItem>
                    </MudSelect>
                    <MudTextField T="string"
                                  @bind-Value="_editorModel.Notes"
                                  Label="Notes"></MudTextField>

                    <div class="d-flex align-center mb-3">
                        <MudText Typo="Typo.h5" Class="mr-4">Tags</MudText>
                        <MudButton StartIcon="Icons.Material.Filled.ContentPaste"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="PasteLinkAsync">
                            Paste Link
                        </MudButton>
                    </div>
                    
                    <MudSimpleTable Hover="true" Dense="true">
                        <thead>
                            <tr>
                                <th>Tag</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>App Service</td>
                                <td><a href="https://www.google.com">App Service</a></td>
                            </tr>
                        <tr>
                            <td>Environment</td>
                            <td>Development</td>
                        </tr>
                        <tr>
                            <td>
                                <MudTextField T="string" 
                                              @bind-Value="_editorModel.NewTagName"
                                              Placeholder="Tag name"
                                              Variant="Variant.Outlined"></MudTextField>
                            </td>
                            <td>
                                <MudTextField T="string" 
                                              @bind-Value="_editorModel.NewTagValue"
                                              Placeholder="Tag value or URL"
                                              Variant="Variant.Outlined"></MudTextField>
                            </td>
                        </tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudButton OnClick="@(async () => SubmitAsync())"
                               Disabled="@(!_success)">Save</MudButton>


                </MudForm>



            </MudItem>
        </MudGrid>
    </MudContainer>
</MudContainer>

