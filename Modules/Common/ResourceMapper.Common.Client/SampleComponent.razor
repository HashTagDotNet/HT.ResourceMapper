@using ResourceMapper.Common.Shared.Contracts
@inject HttpClient HttpClient

<FluentCard Style="width: 100%;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 24px;">
        <FluentLabel Typo="Typography.Subject">Server Date & Time</FluentLabel>
        
        @if (isLoading)
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                <FluentProgressRing Style="width: 20px; height: 20px;" />
                <FluentLabel>Loading server date...</FluentLabel>
            </FluentStack>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="width: 100%;">
                @errorMessage
            </FluentMessageBar>
        }
        else if (dateTimeResponse != null)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                <FluentLabel Typo="Typography.Body">
                    <strong>Current server date:</strong> @dateTimeResponse.FoundDate.ToString("dddd, MMMM dd, yyyy")
                </FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="font-size: 0.85em; color: var(--neutral-foreground-rest);">
                    <strong>Time:</strong> @dateTimeResponse.FoundDate.ToString("hh:mm:ss tt")
                </FluentLabel>
            </FluentStack>
        }
        
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentButton Appearance="Appearance.Accent" 
                         @onclick="RefreshDateTime" 
                         Disabled="@isLoading">
                ?? Refresh Date
            </FluentButton>
            
            <FluentNumberField @bind-Value="daysOffset" 
                              Label="Days offset" 
                              Style="width: 120px;" 
                              Min="-365" 
                              Max="365" />
            
            <FluentButton Appearance="Appearance.Outline" 
                         @onclick="GetDateWithOffset" 
                         Disabled="@isLoading">
                Get Date
            </FluentButton>
        </FluentStack>
    </FluentStack>
</FluentCard>