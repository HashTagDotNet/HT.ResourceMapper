@using System.Net.Http.Json
@using ResourceMapper.Feature1.Shared.Contracts
@inject HttpClient HttpClient

<div class="card my-component">
    <div class="card-header">
        <h5 class="card-title">Server Date</h5>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }
        else if (dateTimeResponse != null)
        {
            <p class="card-text">
                Current server date: <strong>@dateTimeResponse.CurrentDateTime.ToString("yyyy-MM-dd HH:mm:ss")</strong>
            </p>
        }
        <button class="btn btn-primary" @onclick="RefreshDate" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <text> Loading...</text>
            }
            else
            {
                <text>Refresh Date</text>
            }
        </button>
    </div>
</div>

