{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "MacroPoint": {
    "Azure": {
      "ResourceExplorer": {
        "ConnectionStrings": {
          "Database": {
            "RO": "Server=(localdb)\\MSSQLLocalDB;Database=ResourceExplorer;Integrated Security=true;TrustServerCertificate=true",
            "RW": "Server=(localdb)\\MSSQLLocalDB;Database=ResourceExplorer;Integrated Security=true;TrustServerCertificate=true"
          }
        }
      }
    }
  }
}
