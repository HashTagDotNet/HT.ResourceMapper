@using MacroPoint.Azure.ResourceExplorer.Common.Shared.Editor
@using MacroPoint.Azure.ResourceExplorer.Common.Shared.Editor.Contracts
@inject IDialogService DialogService

@* §3: heading + description, so the panel subtitle outranks the row text below it (PL-31). *@
<div class="rm-section-heading">@Heading</div>
<div class="rm-section-desc">@HelpText</div>

<div class="rm-deps-editor">
    @{
        var visibleRows = VisibleRows();
    }
    @if (visibleRows.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="rm-deps-empty">No resources added.</MudText>
    }
    else
    {
        @foreach (var row in visibleRows)
        {
            <div class="rm-dep-row">
                <div class="rm-dep-name">@row.OtherResourceName</div>
                <div class="rm-dep-type">@row.OtherResourceType</div>
                <div class="rm-dep-domain">@(string.IsNullOrEmpty(row.OtherDomain) ? "—" : row.OtherDomain)</div>
                <div class="rm-dep-remove">
                    @if (!ReadOnly)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="@(() => RemoveRow(row))" />
                    }
                </div>
            </div>
        }
    }
</div>

@if (!ReadOnly)
{
    <div class="mt-3 rm-dep-add rm-fk-add">
        <ResourcePicker Domain="@Domain" DomainLabel="@DomainLabel" PointToGeneralTab="@PointToGeneralTab" ExcludeResourceUid="@ExcludeResourceUid"
                        ExcludedUids="@ExcludedUids()" OnPicked="OnPicked"
                        OnCreateNewRequested="RaiseCreateNewRequested" />
        <div class="rm-fk-action">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add"
                       Disabled="@string.IsNullOrWhiteSpace(Domain)" OnClick="RaiseCreateNewRequested"
                       Class="rm-dep-create-new">
                Create new…
            </MudButton>
        </div>
    </div>
}

@code {
    [Parameter] public List<DependencyRowEditor> Rows { get; set; } = new();
    [Parameter] public string Direction { get; set; } = string.Empty; // "DependsOn" | "DependentOn"
    [Parameter] public string HelpText { get; set; } = string.Empty;

    /// <summary>Section heading (§3). Derived from Direction so the two usages can't be labelled
    /// inconsistently by their call sites.</summary>
    private string Heading => Direction == "DependentOn" ? "Dependent On" : "Dependencies";
    [Parameter] public string? Domain { get; set; }

    /// <summary>User-facing name of the domain field, passed through to ResourcePicker (PL-33).</summary>
    [Parameter] public string DomainLabel { get; set; } = "Domain";
    /// <summary>Passed through to ResourcePicker; false on quick add, where there is no General tab.</summary>
    [Parameter] public bool PointToGeneralTab { get; set; } = true;
    [Parameter] public string? ExcludeResourceUid { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnFieldChanged { get; set; }

    /// <summary>
    /// "Create new…" (the standalone button or the picker's no-matches state): the quick-add form
    /// opens as a dialog over this one, pre-set to this resource's domain, and the resource it saves
    /// is linked here exactly as a pick would be. Nothing navigates, so nothing on this form is lost.
    /// </summary>
    private async Task RaiseCreateNewRequested()
    {
        var parameters = new DialogParameters { { nameof(QuickAddDialog.InitialDomain), Domain } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<QuickAddDialog>("Add Resource", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ResourcePickerItem created) return;

        await OnPicked(created);
    }

    private List<DependencyRowEditor> VisibleRows() => Rows.Where(r => !r.IsRemoved).ToList();

    private List<string> ExcludedUids() => VisibleRows().Select(r => r.OtherResourceUid).ToList();

    private async Task OnPicked(ResourcePickerItem item)
    {
        var removedRow = Rows.FirstOrDefault(r => r.IsRemoved && string.Equals(r.OtherResourceUid, item.ResourceUid, StringComparison.Ordinal));
        if (removedRow != null)
        {
            // RD10: re-adding a target whose row was flagged removed un-removes it rather than
            // appending a duplicate.
            removedRow.IsRemoved = false;
        }
        else if (!Rows.Any(r => !r.IsRemoved && string.Equals(r.OtherResourceUid, item.ResourceUid, StringComparison.Ordinal)))
        {
            Rows.Add(new DependencyRowEditor
            {
                Direction = Direction,
                OtherResourceUid = item.ResourceUid,
                OtherResourceName = item.ResourceName,
                OtherResourceType = item.ResourceTypeName,
                OtherDomain = item.Domain,
                IsNew = true
            });
        }

        await OnFieldChanged.InvokeAsync();
    }

    private async Task RemoveRow(DependencyRowEditor row)
    {
        // A never-persisted row (added this session) can just vanish; a row that came from the
        // loaded model must stay (flagged IsRemoved) so IsDirty/save can see the removal —
        // mirror of #7's tag-row removal.
        if (row.IsNew)
        {
            Rows.Remove(row);
        }
        else
        {
            row.IsRemoved = true;
        }

        await OnFieldChanged.InvokeAsync();
    }
}
