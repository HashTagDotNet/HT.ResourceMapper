@page "/"
@using ResourceMapper.Common.Client

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Welcome to ResourceMapper</MudText>
<MudText Typo="Typo.body1" Class="mb-6">A Blazor WebAssembly application with modular architecture powered by MudBlazor.</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-3" /> Quick Start
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Welcome to the ResourceMapper application. This is your central hub for managing and organizing resources with hashtag-based categorization.
                </MudText>
                <MudList T="string">
                    <MudListItem Icon="Icons.Material.Filled.Search" Text="Search and filter resources" />
                    <MudListItem Icon="Icons.Material.Filled.Add" Text="Add new resources" />
                    <MudListItem Icon="Icons.Material.Filled.Tag" Text="Organize with tags" />
                    <MudListItem Icon="Icons.Material.Filled.ImportExport" Text="Import/Export data" />
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="Icons.Material.Filled.GetStarted">
                    Get Started
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="Icons.Material.Filled.Help">
                    Learn More
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="Icons.Material.Filled.Schedule" Class="mr-3" /> System Status
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-3">Current server time:</MudText>
                <MudChip T="string" Icon="Icons.Material.Filled.AccessTime" Color="Color.Info">
                    @DateTime.Now.ToString("MMM dd, yyyy HH:mm:ss")
                </MudChip>
                
                <MudText Typo="Typo.body2" Class="mt-4 mb-3">Application info:</MudText>
                <MudChip T="string" Icon="Icons.Material.Filled.Code" Color="Color.Success">
                    .NET 9.0
                </MudChip>
                <MudChip T="string" Icon="Icons.Material.Filled.Web" Color="Color.Primary" Class="ml-2">
                    Blazor WASM
                </MudChip>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

