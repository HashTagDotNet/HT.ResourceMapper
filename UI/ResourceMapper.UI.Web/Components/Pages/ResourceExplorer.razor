@page "/explore/{ResourceUid}"
@page "/explore/shared/{ShareId}"
@using Microsoft.JSInterop
@using ResourceMapper.Common.Server.Explorer.Interfaces
@using ResourceMapper.Common.Shared.Explorer
@using ResourceMapper.Common.Shared.Explorer.Diagrams
@using ResourceMapper.Common.Shared.Explorer.Diagrams.Contracts
@using ResourceMapper.UI.Web.Explorer
@using ResourceMapper.UI.Web.Components.Explorer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IExplorerService ExplorerService
@inject IDiagramService DiagramService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Explorer</PageTitle>

@* §7: the explorer gets the "Shell" treatment — breadcrumb + fixed title — even though its canvas
   styling is staged last. The trail is deeper here because the diagram is always of some resource,
   so "back to that resource" is as useful as "back to the grid". *@
<div class="rm-explorer-host">
    <PageHeader Title="@ExplorerTitle" Parents="@ExplorerCrumbs" />

    <div class="rm-explorer-bar">
        @* Group 1 — diagram lifecycle: what happens to the saved artefact. *@
        <div class="rm-explorer-bar-group" role="group" aria-label="Diagram">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveAsync" Disabled="_isReadOnly">Save</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                       StartIcon="@Icons.Material.Outlined.SaveAs" OnClick="SaveAsAsync">Save As</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                       StartIcon="@Icons.Material.Outlined.FolderOpen" OnClick="OpenAsync">Open</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                       StartIcon="@Icons.Material.Outlined.Share" OnClick="ShareAsync">Share</MudButton>
            <MudMenu Label="Export" StartIcon="@Icons.Material.Outlined.Download" Size="Size.Small"
                     Variant="Variant.Outlined" Class="ml-1">
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyImageAsync">Copy image</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Image" OnClick="SavePngAsync">Save PNG</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Polyline" OnClick="SaveSvgAsync">Save SVG</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Print" OnClick="PrintAsync">Print / PDF</MudMenuItem>
            </MudMenu>
            <MudTooltip Text="@(_canDeleteCurrent ? $"Delete “{_diagramName}”" : "Only a saved diagram you own can be deleted")">
                <MudIconButton Size="Size.Small" Color="Color.Error" Class="ml-1"
                               Icon="@Icons.Material.Outlined.DeleteOutline" aria-label="Delete diagram"
                               OnClick="DeleteCurrentAsync" Disabled="@(!_canDeleteCurrent)" />
            </MudTooltip>
            @if (_isReadOnly)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-1"
                           StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="SaveCopyAsync">Save a copy to mine</MudButton>
            }
        </div>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
        @* Group 2 — canvas view: what happens to the picture on screen, never to the saved artefact. *@
        <div class="rm-explorer-bar-group" role="group" aria-label="View">
            <MudTooltip Text="Fit to screen">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.CenterFocusStrong"
                               aria-label="Fit" OnClick="FitAsync" />
            </MudTooltip>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                       StartIcon="@Icons.Material.Outlined.UnfoldLess" OnClick="CollapseAllAsync">Collapse all</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                       StartIcon="@Icons.Material.Outlined.AutoFixHigh" OnClick="ReTidyAsync">Re-tidy</MudButton>
        </div>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-3">
            @(string.IsNullOrWhiteSpace(_diagramName) ? "(unsaved)" : _diagramName)
        </MudText>
        @if (!string.IsNullOrEmpty(_clientId))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mr-1">
                Client: @(_clientId.Length >= 8 ? _clientId[..8] : _clientId)…
            </MudText>
            <MudTooltip Text="Copy your client id (carry it to another browser)">
                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                               aria-label="Copy client id" OnClick="CopyClientIdAsync" />
            </MudTooltip>
        }
    </div>
    @if (_isReadOnly)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="ma-1">
            Read-only shared diagram — use &ldquo;Save a copy to mine&rdquo; to edit.
        </MudAlert>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="ma-2">@_error</MudAlert>
    }
    <div class="rm-explorer-canvas" @ref="_canvasEl"></div>
    <div class="rm-explorer-nav">
        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Variant="Variant.Filled"
                       aria-label="Zoom in" OnClick="@(() => ZoomAsync(1.2))" />
        <MudIconButton Icon="@Icons.Material.Outlined.Remove" Size="Size.Small" Variant="Variant.Filled"
                       aria-label="Zoom out" OnClick="@(() => ZoomAsync(0.8))" />
        <div class="rm-explorer-dpad">
            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Size="Size.Small"
                           aria-label="Pan up" OnClick="@(() => PanAsync(0, 60))" />
            <div class="rm-explorer-dpad-mid">
                <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowLeft" Size="Size.Small"
                               aria-label="Pan left" OnClick="@(() => PanAsync(60, 0))" />
                <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowRight" Size="Size.Small"
                               aria-label="Pan right" OnClick="@(() => PanAsync(-60, 0))" />
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small"
                           aria-label="Pan down" OnClick="@(() => PanAsync(0, -60))" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ResourceUid { get; set; }
    [Parameter] public string? ShareId { get; set; }

    private ElementReference _canvasEl;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ResourceExplorer>? _selfRef;
    private readonly HashSet<string> _expanded = new();
    private string? _error;
    private bool _initialized;
    private bool _isReadOnly;
    private string _preset = "nameType";
    private string _clientId = string.Empty;
    /// <summary>
    /// §7 page chrome. Prefers the saved diagram's name, then the seed resource's name — the same
    /// precedence the browser tab title already used, kept in one place so they cannot diverge.
    /// </summary>
    private string ExplorerTitle =>
        !string.IsNullOrWhiteSpace(_diagramName) ? _diagramName
        : !string.IsNullOrWhiteSpace(_seedName) ? $"{_seedName} — dependencies"
        : "Resource Explorer";

    /// <summary>
    /// Trail: Home › Resources › &lt;seed resource&gt; › this diagram. The seed crumb is a real link
    /// back to the record the diagram is of, which is otherwise a dead end.
    /// </summary>
    private (string Text, string Href)[] ExplorerCrumbs =>
        !string.IsNullOrWhiteSpace(_seedName) && !string.IsNullOrWhiteSpace(_seedUid)
            ? [("Resources", "/"), (_seedName, $"/resources/{_seedUid}")]
            : [("Resources", "/")];

    private string _seedUid = string.Empty;
    private string? _diagramUid;
    private string? _shareId;
    private string _diagramName = string.Empty;
    private string _seedName = string.Empty;

    // Delete only makes sense for a diagram that actually exists and that this client owns.
    private bool _canDeleteCurrent => !_isReadOnly && !string.IsNullOrEmpty(_diagramUid);

    private async Task UpdateTitleAsync()
    {
        var title = !string.IsNullOrWhiteSpace(_diagramName) ? _diagramName
                  : (!string.IsNullOrWhiteSpace(_seedName) ? _seedName : "Resource Explorer");
        var subtitle = $"Dependency report · {DateTime.Now:yyyy-MM-dd}";
        await SafeInvokeAsync("setTitle", title, subtitle);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/js/explorer/explorer-canvas.js");
        _selfRef = DotNetObjectReference.Create(this);
        await SafeInvokeAsync("init", _canvasEl, _selfRef);

        _clientId = await ClientIdentity.GetOrCreateAsync(JS);
        StateHasChanged();

        if (!string.IsNullOrEmpty(ShareId))
        {
            await LoadSharedAsync(ShareId);
        }
        else
        {
            _seedUid = ResourceUid ?? string.Empty;
            await LoadNodeAsync(ResourceUid ?? string.Empty, seed: true, expandFromUid: null);
        }
        await SafeInvokeAsync("fit");
        await UpdateTitleAsync();
    }

    private async Task LoadNodeAsync(string uid, bool seed, string? expandFromUid)
    {
        // What's already drawn, so the read can also return the relationships between the nodes it
        // is about to hand back and the ones already on the canvas. Without it a relationship
        // between two visible resources is simply never drawn — the picture claims they are
        // unrelated with no hint that anything was left out.
        var known = await SafeInvokeResultAsync<string[]>("nodeIds");

        var response = await ExplorerService.GetNodeAsync(uid, known);
        if (!response.IsSuccess() || response.ApiResponse.Data is null)
        {
            if (seed) { _error = $"Resource '{uid}' not found."; StateHasChanged(); }
            return;
        }
        var node = response.ApiResponse.Data;
        if (seed) { _seedName = node.ResourceName; }

        var nodes = new List<object>
        {
            NodePayload(node.ResourceUid, node.ResourceKey, node.ResourceName, node.ResourceType, node.Domain, node.PrimaryUrl, node.ShortCode, node.IconKey)
        };
        foreach (var n in node.Neighbors)
        {
            nodes.Add(NodePayload(n.ResourceUid, n.ResourceKey, n.ResourceName, n.ResourceType, n.Domain, n.PrimaryUrl, n.ShortCode, n.IconKey));
        }

        // Edges are authoritative: they cover every relationship inside the on-canvas set, not just
        // the ones touching this node. The neighbour-derived fallback only kicks in against a
        // database whose Resource_GetForExplorer predates the 'Edge' rows, so a stale deployment
        // degrades to the old (incomplete) picture rather than to no edges at all.
        var edges = new List<object>();
        if (node.Edges.Count > 0)
        {
            foreach (var e in node.Edges) edges.Add(new { source = e.FromUid, target = e.ToUid });
        }
        else
        {
            foreach (var n in node.Neighbors)
            {
                var src = n.Direction == "DependsOn" ? node.ResourceUid : n.ResourceUid;
                var tgt = n.Direction == "DependsOn" ? n.ResourceUid : node.ResourceUid;
                edges.Add(new { source = src, target = tgt });
            }
        }

        await SafeInvokeAsync("addGraph", nodes, edges, seed ? uid : null, expandFromUid);
        _expanded.Add(uid);
        await SafeInvokeAsync("markExpanded", uid, true);
    }

    [JSInvokable]
    public async Task OnNodeTapped(string uid)
    {
        if (_expanded.Contains(uid))
        {
            await SafeInvokeAsync("collapse", uid);
            _expanded.Remove(uid);
        }
        else
        {
            await LoadNodeAsync(uid, seed: false, expandFromUid: uid);
        }
    }

    [JSInvokable]
    public async Task OnNodeRemoveRequested(string uid)
    {
        var surviving = await SafeInvokeResultAsync<string[]>("removeNode", uid) ?? System.Array.Empty<string>();
        _expanded.IntersectWith(surviving);
    }

    private async Task CollapseAllAsync()
    {
        await SafeInvokeAsync("collapseAll");
        _expanded.Clear();
    }

    private async Task CopyClientIdAsync()
    {
        if (string.IsNullOrEmpty(_clientId)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _clientId); }
        catch { /* clipboard unavailable */ }
    }

    private async Task FitAsync() => await SafeInvokeAsync("fit");
    private async Task ZoomAsync(double factor) => await SafeInvokeAsync("zoomBy", factor);
    private async Task PanAsync(double dx, double dy) => await SafeInvokeAsync("panByDir", dx, dy);
    private async Task ReTidyAsync() => await SafeInvokeAsync("reTidy");

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_diagramName)) { await SaveAsAsync(); return; }
        await PersistAsync(_diagramUid, _diagramName);
    }

    private async Task SaveAsAsync()
    {
        var parameters = new DialogParameters { ["Name"] = _diagramName };
        var dialog = await DialogService.ShowAsync<DiagramNameDialog>("Save Diagram As", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var name = result.Data as string;
        if (string.IsNullOrWhiteSpace(name)) return;
        await PersistAsync(null, name!);   // null uid => new diagram
    }

    private async Task PersistAsync(string? diagramUid, string name)
    {
        var json = await SafeInvokeResultAsync<string>("serializeJson") ?? "{}";
        var request = new SaveDiagramRequest
        {
            DiagramUid = diagramUid,
            Name = name,
            SeedResourceUid = _seedUid,
            DisplayPreset = _preset,
            DiagramJson = json
        };
        var resp = await DiagramService.SaveAsync(_clientId, request);
        if (resp.IsSuccess() && resp.ApiResponse.Data is not null)
        {
            _diagramUid = resp.ApiResponse.Data.DiagramUid;
            _shareId = resp.ApiResponse.Data.ShareId;
            _diagramName = name;
            _isReadOnly = false;
            await UpdateTitleAsync();
            Snackbar.Add($"Saved “{name}”.", Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Save failed.", Severity.Error);
        }
    }

    private async Task OpenAsync()
    {
        _error = null;
        var parameters = new DialogParameters { ["ClientId"] = _clientId };
        var dialog = await DialogService.ShowAsync<OpenDiagramDialog>("Open Diagram", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var shareId = result.Data as string;
        if (string.IsNullOrWhiteSpace(shareId)) return;

        var resp = await DiagramService.GetByShareIdAsync(shareId!, _clientId);
        if (!resp.IsSuccess() || resp.ApiResponse.Data is null)
        {
            Snackbar.Add("Could not open diagram.", Severity.Error);
            return;
        }
        var model = resp.ApiResponse.Data;

        _isReadOnly = !model.IsOwner;
        _diagramUid = model.IsOwner ? model.DiagramUid : null;
        _shareId = model.ShareId;
        _diagramName = model.Name;
        _seedUid = model.SeedResourceUid;
        _preset = string.IsNullOrWhiteSpace(model.DisplayPreset) ? "nameType" : model.DisplayPreset;

        var expanded = await SafeInvokeResultAsync<string[]>("loadJson", model.DiagramJson);
        if (expanded is null)
        {
            _error = "This diagram could not be loaded (corrupt data).";
            StateHasChanged();
            return;
        }
        _expanded.Clear();
        foreach (var u in expanded) _expanded.Add(u);
        await UpdateTitleAsync();

        Snackbar.Add($"Opened “{model.Name}”.", Severity.Success);
        StateHasChanged();
    }

    private async Task LoadSharedAsync(string shareId)
    {
        _error = null;
        var resp = await DiagramService.GetByShareIdAsync(shareId, _clientId);
        if (!resp.IsSuccess() || resp.ApiResponse.Data is null)
        {
            _error = "Shared diagram not found.";
            StateHasChanged();
            return;
        }
        var model = resp.ApiResponse.Data;

        _shareId = model.ShareId;
        _diagramName = model.Name;
        _seedUid = model.SeedResourceUid;
        _preset = string.IsNullOrWhiteSpace(model.DisplayPreset) ? "nameType" : model.DisplayPreset;
        _isReadOnly = !model.IsOwner;
        _diagramUid = model.IsOwner ? model.DiagramUid : null;   // suppressed for non-owners

        var expanded = await SafeInvokeResultAsync<string[]>("loadJson", model.DiagramJson);
        if (expanded is null)
        {
            _error = "This shared diagram could not be loaded (corrupt data).";
            StateHasChanged();
            return;
        }
        _expanded.Clear();
        foreach (var u in expanded) _expanded.Add(u);
        await UpdateTitleAsync();
        StateHasChanged();
    }

    private async Task SaveCopyAsync()
    {
        if (string.IsNullOrEmpty(_shareId)) return;
        var resp = await DiagramService.SaveCopyAsync(_clientId, _shareId, null);
        if (resp.IsSuccess() && resp.ApiResponse.Data is not null)
        {
            _diagramUid = resp.ApiResponse.Data.DiagramUid;
            _shareId = resp.ApiResponse.Data.ShareId;
            _diagramName = $"{_diagramName} (copy)";   // matches the server-side default name
            _isReadOnly = false;
            await UpdateTitleAsync();
            Snackbar.Add("Saved a copy to your diagrams.", Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Could not save a copy.", Severity.Error);
        }
    }

    private async Task ShareAsync()
    {
        if (string.IsNullOrEmpty(_shareId))
        {
            await SaveAsAsync();                       // must be saved to have a share id
            if (string.IsNullOrEmpty(_shareId)) return; // cancelled
        }
        var url = $"{Navigation.BaseUri.TrimEnd('/')}/explore/shared/{_shareId}";
        var label = string.IsNullOrWhiteSpace(_diagramName) ? url : _diagramName;
        var ok = await SafeInvokeResultAsync<bool>("copyRichLink", url, label);
        Snackbar.Add(ok ? "Share link copied." : url, ok ? Severity.Success : Severity.Info);
    }

    private async Task CopyImageAsync()
    {
        var ok = await SafeInvokeResultAsync<bool>("copyPng");
        Snackbar.Add(ok ? "Image copied to clipboard." : "Copy image failed.",
            ok ? Severity.Success : Severity.Error);
    }

    // Exports used to fail silently — a click that produced no file and no message. Each JS export
    // now reports success, and anything false becomes a snackbar.
    private async Task SavePngAsync()
    {
        if (!await SafeInvokeResultAsync<bool>("savePng", DownloadName()))
            Snackbar.Add("Could not save the PNG.", Severity.Error);
    }

    private async Task SaveSvgAsync()
    {
        if (!await SafeInvokeResultAsync<bool>("saveSvg", DownloadName()))
            Snackbar.Add("Could not save the SVG.", Severity.Error);
    }

    private async Task PrintAsync()
    {
        if (!await SafeInvokeResultAsync<bool>("printDiagram"))
            Snackbar.Add("Could not open the print view — check that pop-ups are allowed.", Severity.Error);
    }

    private async Task DeleteCurrentAsync()
    {
        if (!_canDeleteCurrent) return;
        // Plain-string message (not MarkupString): the diagram name is user-supplied.
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Diagram?",
            $"“{_diagramName}” will be permanently deleted. The picture stays on screen but is no longer saved.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var resp = await DiagramService.DeleteAsync(_clientId, _diagramUid!);
        if (!resp.IsSuccess())
        {
            Snackbar.Add("Could not delete the diagram.", Severity.Error);
            return;
        }
        var deletedName = _diagramName;
        _diagramUid = null;
        _shareId = null;
        _diagramName = string.Empty;
        await UpdateTitleAsync();
        Snackbar.Add($"Deleted “{deletedName}”.", Severity.Success);
        StateHasChanged();
    }

    private string DownloadName()
    {
        var name = string.IsNullOrWhiteSpace(_diagramName) ? "diagram" : _diagramName;
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        var clean = new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(clean) ? "diagram" : clean;
    }

    private static object NodePayload(string uid, string key, string name, string type, string? domain, string? url, string? shortCode, string? iconKey)
        => new { uid, key, name, type, domain, primaryUrl = url, shortCode, iconKey };

    private async Task SafeInvokeAsync(string identifier, params object?[] args)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync(identifier, args); }
        catch (JSDisconnectedException) { /* circuit gone — nothing to do */ }
        catch (ObjectDisposedException) { /* module disposed mid-call */ }
    }

    private async Task<T?> SafeInvokeResultAsync<T>(string identifier, params object?[] args)
    {
        if (_module is null) return default;
        try { return await _module.InvokeAsync<T>(identifier, args); }
        catch (JSDisconnectedException) { return default; }
        catch (ObjectDisposedException) { return default; }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* circuit already torn down */ }
        catch (ObjectDisposedException) { /* already disposed */ }
        _selfRef?.Dispose();
    }
}
