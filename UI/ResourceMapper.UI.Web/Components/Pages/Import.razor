@page "/import"
@page "/export"
@using System.Text.Json
@using ResourceMapper.Common.Server.Resources.Interfaces
@using ResourceMapper.Common.Shared.Export.Contracts
@using ResourceMapper.Common.Shared.Import.Contracts
@implements IAsyncDisposable
@inject IImportService ImportService
@inject IExportService ExportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Import / Export — Hashtag Resource Mapper</PageTitle>

<PageHeader Title="Import / Export"
            Description="Move the catalog in and out as JSON. Both directions use the same document format, so an exported file can be re-imported unchanged." />

<MudPaper Elevation="0" Class="pa-6 mb-4" Style="border:1px solid var(--mud-palette-divider);">
    <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-1">Export</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Downloads the whole catalog — every resource with its type, domain, tags and dependencies —
        as a JSON file in the import format. Each resource also carries its <code>uid</code>, which
        import ignores.
    </MudText>

    <MudSwitch T="bool" @bind-Value="_includeTagDefinitions" Color="Color.Primary" Class="mb-1"
               Label="Include tag definitions (for seeding an empty database)" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
        Off by default. The import format cannot carry a tag definition's display name, requirement
        level, domain-tag flag or display order, so re-importing this section into a populated
        database resets those to defaults.
    </MudText>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_exporting"
               StartIcon="@Icons.Material.Filled.Download" OnClick="RunExport">
        @(_exporting ? "Exporting…" : "Export catalog")
    </MudButton>

    @if (_exporting)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-3" />
    }

    @if (_exportSummary is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            @_exportSummary
        </MudAlert>
    }

    @if (_exportWarnings is { Count: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            <MudText Typo="Typo.body2" Style="font-weight:600;" Class="mb-1">
                @_exportWarnings.Count item(s) could not be represented in the import format:
            </MudText>
            <ul style="margin:0;padding-left:1.1rem;">
                @foreach (var w in _exportWarnings)
                {
                    <li><MudText Typo="Typo.caption">@w</MudText></li>
                }
            </ul>
        </MudAlert>
    }
</MudPaper>

<MudPaper Elevation="0" Class="pa-6 mb-4" Style="border:1px solid var(--mud-palette-divider);">
    <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-1">Import</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Choose a JSON file to import:</MudText>
    <InputFile OnChange="OnInputFileChange" accept=".json" />

    @if (_fileName is not null)
    {
        <div class="d-flex align-center mt-4 gap-4">
            <MudText Typo="Typo.body2">@_fileName</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _request is null)"
                       OnClick="RunImport">
                @(_busy ? "Importing…" : "Import")
            </MudButton>
        </div>
    }
</MudPaper>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@if (_message is not null)
{
    <MudAlert Severity="@_messageSeverity" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_message</MudAlert>
}

@if (_summary is not null)
{
    <MudSimpleTable Dense="true" Bordered="true" Elevation="0"
                    Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
        <thead>
            <tr><th>Section</th><th>Created</th><th>Updated</th><th>Skipped</th></tr>
        </thead>
        <tbody>
            <tr><td>Resource Types</td><td>@_summary.ResourceTypes.Created</td><td>@_summary.ResourceTypes.Updated</td><td>@_summary.ResourceTypes.Skipped</td></tr>
            <tr><td>Tag Definitions</td><td>@_summary.TagDefinitions.Created</td><td>@_summary.TagDefinitions.Updated</td><td>@_summary.TagDefinitions.Skipped</td></tr>
            <tr><td>Resources</td><td>@_summary.Resources.Created</td><td>@_summary.Resources.Updated</td><td>@_summary.Resources.Skipped</td></tr>
        </tbody>
    </MudSimpleTable>
}

@if (_errors is { Count: > 0 })
{
    <MudSimpleTable Dense="true" Bordered="true" Elevation="0"
                    Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
        <thead>
            <tr><th>Section</th><th>Key</th><th>Field</th><th>Message</th></tr>
        </thead>
        <tbody>
            @foreach (var e in _errors)
            {
                <tr><td>@e.Section</td><td>@e.Key</td><td>@e.Field</td><td>@e.Message</td></tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    private string? _fileName;
    private ImportRequest? _request;
    private bool _busy;
    private ImportSummary? _summary;
    private List<ImportError>? _errors;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;

    private bool _exporting;
    private bool _includeTagDefinitions;
    private string? _exportSummary;
    private List<string>? _exportWarnings;
    private IJSObjectReference? _downloadModule;

    // ---------------- export ----------------

    private async Task RunExport()
    {
        _exporting = true;
        _exportSummary = null;
        _exportWarnings = null;
        try
        {
            var options = new ExportOptions
            {
                IncludeResourceTypes = true,
                IncludeTagDefinitions = _includeTagDefinitions
            };

            var response = await ExportService.ExportAsync(options, CancellationToken.None);
            var data = response.ApiResponse.Data;

            if (!response.IsSuccess() || data is null)
            {
                Snackbar.Add("Export failed", Severity.Error);
                _exportSummary = null;
                return;
            }

            var json = ExportJson.Serialize(data.Document);
            var fileName = $"resourcemapper-catalog-{DateTime.Now:yyyyMMdd-HHmmss}.json";

            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/file-download.js");
            await _downloadModule.InvokeVoidAsync("downloadText", fileName, json, "application/json");

            _exportSummary =
                $"Exported {data.ResourceCount} resource(s) and {data.DependencyCount} dependency link(s) to {fileName}.";
            _exportWarnings = data.Warnings.Count > 0 ? data.Warnings : null;

            Snackbar.Add("Export ready", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    // ---------------- import ----------------

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        await OnFileSelected(e.FileCount > 0 ? e.File : null);
    }

    private async Task OnFileSelected(IBrowserFile? file)
    {
        Reset();
        if (file is null) return;
        _fileName = file.Name;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            _request = await JsonSerializer.DeserializeAsync<ImportRequest>(stream, JsonOpts);
            if (_request is null)
                Show("The file did not contain a valid import document.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _fileName = null;
            Show($"Could not read the file: {ex.Message}", Severity.Warning);
        }
    }

    private async Task RunImport()
    {
        if (_request is null) return;
        _busy = true;
        _summary = null;
        _errors = null;
        _message = null;
        try
        {
            var response = await ImportService.ImportAsync(_request, CancellationToken.None);
            var data = response.ApiResponse.Data;
            if (response.IsSuccess() && data is not null)
            {
                _summary = data.Summary;
                Show("Import succeeded.", Severity.Success);
                Snackbar.Add("Import succeeded", Severity.Success);
            }
            else
            {
                _errors = data?.Errors ?? new();
                Show($"Import failed — {_errors.Count} issue(s).", Severity.Error);
                Snackbar.Add("Import failed validation", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Show($"Import error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reset()
    {
        _fileName = null;
        _request = null;
        _summary = null;
        _errors = null;
        _message = null;
    }

    private void Show(string message, Severity severity)
    {
        _message = message;
        _messageSeverity = severity;
    }

    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is null) return;
        try
        {
            await _downloadModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (browser closed / navigated away) — nothing to release.
        }
    }
}
