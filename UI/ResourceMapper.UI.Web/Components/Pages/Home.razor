@page "/"
@using Microsoft.AspNetCore.Components
@using ResourceMapper.Common.Server.Resources.Interfaces
@implements IDisposable
@inject IResourceService ResourceService
@inject PersistentComponentState AppState
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Resources — Hashtag Resource Mapper</PageTitle>

<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h5" Style="font-weight:600;">Resources</MudText>
    <MudSpacer />
    @if (_items is not null && _loadError is null)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@_items.Count resources</MudText>
    }
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Searchable catalog of cloud resources across environments.
</MudText>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@_loadError</MudAlert>
}
else
{
    <MudDataGrid T="ResourceGridItemModel" Items="@(_items ?? new())" Loading="@(_items is null)"
                 Dense="true" Hover="true" Elevation="0" SortMode="SortMode.Single"
                 Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
        <Columns>
            <PropertyColumn Property="x => x.ResourceName" Title="Name" />
            <PropertyColumn Property="x => x.ResourceType" Title="Type" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <TemplateColumn Title="Tags" Sortable="false">
                <CellTemplate>
                    @if (context.Item.Tags is null || context.Item.Tags.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap rm-tags">
                            @foreach (var tag in context.Item.Tags)
                            {
                                @if (string.Equals(tag.ContentType, "Link", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="rm-tag">
                                        <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" Class="rm-tagicon" />
                                        <MudLink Href="@tag.TagValue" Target="_blank" Typo="Typo.body2">@tag.TagKey</MudLink>
                                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                                       Class="rm-copy" aria-label="Copy link"
                                                       OnClick="@(() => CopyAsync(tag.TagValue))" />
                                    </span>
                                }
                                else
                                {
                                    <span class="rm-tagtext"><span class="rm-tagkey">@tag.TagKey:</span> @tag.TagValue</span>
                                }
                            }
                        </div>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <div class="pa-10 d-flex justify-center">
                <MudText Color="Color.Secondary">No resources yet — use the menu's&nbsp;<strong>Import…</strong>&nbsp;to load data.</MudText>
            </div>
        </NoRecordsContent>
    </MudDataGrid>
}

@code {
    private List<ResourceGridItemModel>? _items;
    private int _total;
    private string? _loadError;
    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistState);

        // Reuse the prerender result on the interactive pass instead of querying the DB twice.
        if (AppState.TryTakeFromJson<GridSnapshot>("grid", out var snap) && snap is not null)
        {
            _items = snap.Items ?? new();
            _total = snap.Total;
            _loadError = snap.Error;
            return;
        }

        try
        {
            var request = new ResourceGridRequest { Skip = 0, Take = 100, OrderBy = "ResourceName", OrderDirection = "Asc" };
            var response = await ResourceService.GetResourceGridItems(request, CancellationToken.None);
            if (response.IsSuccess() && response.ApiResponse.Data is not null)
            {
                _items = response.ApiResponse.Data.Items ?? new();
                _total = response.ApiResponse.Data.TotalItems;
            }
            else
            {
                _items = new();
                _loadError = "Unable to load resources.";
            }
        }
        catch
        {
            _items = new();
            _loadError = "Unable to load resources — the database may not be available yet.";
        }
    }

    private Task PersistState()
    {
        AppState.PersistAsJson("grid", new GridSnapshot { Items = _items, Total = _total, Error = _loadError });
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private async Task CopyAsync(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Snackbar.Add("Link copied", Severity.Normal);
        }
        catch
        {
            Snackbar.Add("Couldn't copy link", Severity.Warning);
        }
    }

    private sealed class GridSnapshot
    {
        public List<ResourceGridItemModel>? Items { get; set; }
        public int Total { get; set; }
        public string? Error { get; set; }
    }
}
