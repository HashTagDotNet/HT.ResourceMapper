@page "/resources"
@page "/resources/{ResourceUid}"
@implements IDisposable
@using HT.Api.Client.Contracts.Models
@using HT.Api.Service.Contracts
@using ResourceMapper.Common.Server.Resources.Interfaces
@using ResourceMapper.Common.Shared.Editor
@using ResourceMapper.Common.Shared.Editor.Contracts
@using ResourceMapper.UI.Web.Components.Editor
@inject IResourceService ResourceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject EditorNavStack Stack

<PageTitle>@PageTitleText — Hashtag Resource Mapper</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_loadError</MudAlert>
}
else if (_model is not null && _response is not null)
{
    <div class="d-flex align-center mb-3">
        <MudText Typo="Typo.h5" Style="font-weight:600;">@PageTitleText</MudText>
        <MudSpacer />
        @if (_model.IsPersisted)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete"
                       Disabled="@_deleting" OnClick="DeleteAsync" Class="mr-2">Delete</MudButton>
        }
        @if (_mode == "View")
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="EnterEditMode">Edit</MudButton>
        }
    </div>

    <MudPaper Elevation="0" Class="pa-4 rm-editor-paper">
        <MudTabs Class="rm-editor-tabs">
            <MudTabPanel Text="General">
                <GeneralTab Model="_model" ResourceTypes="_response.ResourceTypes" DomainAllowedValues="_response.DomainAllowedValues"
                            DomainLabel="@DomainLabel" ReadOnly="@(_mode == "View")" DomainLocked="_domainLocked"
                            OnFieldChanged="OnGeneralFieldChanged" OnCheckUniqueness="CheckUniquenessAsync"
                            OnResourceTypeChanged="OnResourceTypeChanged" OnResourceDomainChanged="OnResourceDomainChanged" />
            </MudTabPanel>
            <MudTabPanel Text="Tags">
                <TagsTab Model="_model" TagDictionary="_response.TagDictionary" ReadOnly="@(_mode == "View")"
                         OnFieldChanged="OnGeneralFieldChanged" />
            </MudTabPanel>
            <MudTabPanel Text="Dependencies">
                <DependencyTab Rows="_model.DependsOn" Direction="DependsOn"
                                HelpText="What this resource depends on."
                                Domain="@_model.Domain.EditedValue" DomainLabel="@DomainLabel"
                                ExcludeResourceUid="@_model.ResourceUid"
                                ReadOnly="@(_mode == "View")" OnFieldChanged="OnGeneralFieldChanged"
                                OnCreateNewRequested="InitiateNestedCreate" />
            </MudTabPanel>
            <MudTabPanel Text="Dependent On">
                <DependencyTab Rows="_model.DependentOn" Direction="DependentOn"
                                HelpText="What depends on this resource."
                                Domain="@_model.Domain.EditedValue" DomainLabel="@DomainLabel"
                                ExcludeResourceUid="@_model.ResourceUid"
                                ReadOnly="@(_mode == "View")" OnFieldChanged="OnGeneralFieldChanged"
                                OnCreateNewRequested="InitiateNestedCreate" />
            </MudTabPanel>
            <MudTabPanel Text="Review">
                <ReviewTab Model="_model" DomainLabel="@DomainLabel" />
            </MudTabPanel>
            @* History tab: scaffolded per design §12, not built — commented out until audit/versioning lands.
            <MudTabPanel Text="History">
                <HistoryTab Model="_model" />
            </MudTabPanel>
            *@
        </MudTabs>

        @if (_mode != "View")
        {
            <div class="d-flex justify-end mt-4 rm-editor-footer">
                <MudButton Variant="Variant.Text" OnClick="Cancel" Class="mr-2" Disabled="@_saving">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveAsync">
                    @(_saving ? "Saving…" : "Save")
                </MudButton>
            </div>
        }
    </MudPaper>
}

@code {
    [Parameter] public string? ResourceUid { get; set; }

    /// <summary>Nested-editor marker (?n=k). Its presence (rather than mere Stack.HasFrames)
    /// distinguishes a genuine nested descent from a stale/abandoned frame (RD12) — see
    /// OnParametersSetAsync. Each nested level gets a distinct k so browser history and
    /// OnParametersSetAsync treat descents as real navigations (RD17).</summary>
    [SupplyParameterFromQuery(Name = "n")]
    public int? NestedLevel { get; set; }

    private OpenEditorResponse? _response;
    private ResourceEditorModel? _model => _response?.EditorModel;
    private string _mode = "Create";
    private bool _loading = true;
    private string? _loadError;
    private bool _saving;
    private bool _deleting;
    private bool _domainLocked;

    /// <summary>
    /// PL-33: the user-facing name of the domain/boundary field, read from the domain tag's own
    /// DisplayName ("Subscription" in this deployment) and passed to every tab that names it. It
    /// used to be derived inside GeneralTab and hardcoded elsewhere, so the same field read
    /// "Subscription" on General and "Domain" on Review. Deriving it once here means a deployment
    /// that renames the tag renames it everywhere; "Domain" is only the fallback when no domain tag
    /// is defined at all.
    /// </summary>
    private string DomainLabel =>
        _response?.TagDictionary?.FirstOrDefault(t => t.IsDomainTag)?.DisplayName ?? "Domain";

    private bool _hasLoadedOnce;
    private string? _lastLoadedUid;
    private int? _lastNestedLevel;

    // Dirty-guard bookkeeping (RD1/RD3): one-shot suppression for intentional navigations, and a
    // re-entrancy guard while the unsaved-changes dialog is open.
    private bool _suppressNavGuard;
    private bool _navPromptOpen;
    private IDisposable? _locationChangingRegistration;

    protected override async Task OnParametersSetAsync()
    {
        if (IsReturningToFrame())
        {
            RestoreFromFrame();
            return;
        }

        // A fresh top-level entry (no ?n marker) abandons any stale/abandoned nested frame
        // (RD12) so the hamburger "Create Resource" is always a genuine fresh start.
        if (NestedLevel is null)
            Stack.Clear();

        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        }
    }

    public void Dispose() => _locationChangingRegistration?.Dispose();

    private string PageTitleText => _mode switch
    {
        "Create" => "Create Resource",
        _ => string.IsNullOrWhiteSpace(_model?.Name.EditedValue) ? "Resource" : _model!.Name.EditedValue
    };

    /// <summary>Normalizes a location to a comparable, no-leading-slash base-relative form,
    /// regardless of whether it arrives absolute (Navigation.Uri) or root-relative
    /// (LocationChangingContext.TargetLocation isn't documented to guarantee either shape).</summary>
    private string NormalizeRoute(string location)
    {
        if (Uri.TryCreate(location, UriKind.Absolute, out _))
            return Navigation.ToBaseRelativePath(location);
        return location.TrimStart('/');
    }

    private string CurrentRelativePath() => NormalizeRoute(Navigation.Uri);

    /// <summary>True when the current URL is the parent frame's route — i.e. we're ascending
    /// back to it (via child Save, Cancel, or browser Back), not descending into a fresh nested
    /// create. The ?n marker on nested URLs guarantees a descent's URL never equals its parent's,
    /// so this predicate can't misread a descent as a return (RD6).</summary>
    private bool IsReturningToFrame() =>
        Stack.HasFrames && string.Equals(CurrentRelativePath(), Stack.Peek().ParentRoute, StringComparison.Ordinal);

    private void RestoreFromFrame()
    {
        var frame = Stack.Peek();
        _response = frame.Response;
        _mode = frame.ParentMode;
        _domainLocked = false; // the parent set its own domain; it was never locked
        _loading = false;
        _loadError = null;
        _hasLoadedOnce = true;
        _lastLoadedUid = ResourceUid;
        _lastNestedLevel = NestedLevel;

        if (frame.Returned is not null)
        {
            LinkReturnedChild(frame.Direction, frame.Returned);
            frame.Returned = null;
        }

        Stack.Pop();
    }

    /// <summary>Appends the nested-created child as a new dependency row, deduping against an
    /// existing (or removed) row for the same uid — mirrors DependencyTab.OnPicked's RD9/RD10.</summary>
    private void LinkReturnedChild(string direction, ReturnedChild child)
    {
        if (_model is null) return;
        var rows = direction == "DependsOn" ? _model.DependsOn : _model.DependentOn;

        var removedRow = rows.FirstOrDefault(r => r.IsRemoved && string.Equals(r.OtherResourceUid, child.ResourceUid, StringComparison.Ordinal));
        if (removedRow is not null)
        {
            removedRow.IsRemoved = false;
            return;
        }

        if (rows.Any(r => !r.IsRemoved && string.Equals(r.OtherResourceUid, child.ResourceUid, StringComparison.Ordinal)))
            return;

        rows.Add(new DependencyRowEditor
        {
            Direction = direction,
            OtherResourceUid = child.ResourceUid,
            OtherResourceName = child.Name,
            OtherResourceType = child.TypeName,
            OtherDomain = child.Domain,
            IsNew = true
        });
    }

    /// <summary>Pushes the CURRENT (parent) state onto the stack before navigating — the reused
    /// component instance's _response is about to be overwritten by the nested load, so the
    /// parent's live edits must be stashed first (RD4).</summary>
    private void InitiateNestedCreate(string direction)
    {
        if (_response is null) return;

        Stack.Push(new EditorFrame
        {
            Response = _response,
            ParentRoute = CurrentRelativePath(),
            Direction = direction,
            ParentMode = _mode
        });
        _suppressNavGuard = true;
        Navigation.NavigateTo($"/resources?n={Stack.Depth}");
    }

    private async Task LoadAsync(bool forceReload = false)
    {
        if (!forceReload && _hasLoadedOnce
            && string.Equals(ResourceUid, _lastLoadedUid, StringComparison.Ordinal)
            && _lastNestedLevel == NestedLevel)
            return;

        _hasLoadedOnce = true;
        _lastLoadedUid = ResourceUid;
        _lastNestedLevel = NestedLevel;
        _loading = true;
        _loadError = null;
        try
        {
            var isNew = string.IsNullOrWhiteSpace(ResourceUid);
            _mode = isNew ? "Create" : "View";

            var request = new OpenEditorRequest { Mode = isNew ? "Create" : "Edit", ResourceUid = ResourceUid };
            var response = await ResourceService.GetResourceEditorModelAsync(request, CancellationToken.None);

            if (response.IsSuccess() && response.ApiResponse.Data is not null)
            {
                _response = response.ApiResponse.Data;

                // A nested create (has a ?n marker AND an ancestor frame) is domain-locked to its
                // immediate parent (RD7) — reading Peek() here means a multi-level chain stays
                // same-domain, since each ancestor was itself already locked to its own parent.
                _domainLocked = false;
                if (NestedLevel is not null && Stack.HasFrames)
                {
                    var parentDomain = Stack.Peek().Response.EditorModel.Domain.EditedValue;
                    // Set BOTH Original and Edited so this system pre-fill does not itself count
                    // as a user change — an untouched nested-create page must not read as dirty
                    // (SingleValueEditor.IsChanged compares the two); only an actual edit by the
                    // user should trip the dirty guard.
                    _model!.Domain.OriginalValue = parentDomain;
                    _model!.Domain.EditedValue = parentDomain;
                    _domainLocked = true;
                    OnGeneralFieldChanged();
                }
            }
            else
            {
                _response = null;
                _loadError = "Resource not found.";
            }
        }
        catch (Exception ex)
        {
            _response = null;
            _loadError = $"Could not load: {ex.Message}";
        }
        finally
        {
            _loading = false;
            _suppressNavGuard = false; // RD3 belt-and-braces: a suppress that never met a handler can't leak forward
        }
    }

    private void EnterEditMode() => _mode = "Edit";

    /// <summary>Cancel now confirms when there are unsaved changes — this reverses the design's
    /// OQ3 default ("Cancel is an explicit discard, so it suppresses the guard"), which in practice
    /// discarded real edits with no warning. The guard can never do this for us: the two navigating
    /// branches set _suppressNavGuard themselves, consuming the one-shot before OnLocationChanging
    /// runs, and the persisted branch never navigates at all — so the IsDirty check has to live
    /// here, with the same three-way choice semantics the guard applies (RD1/RD13/RD19).
    /// Async, not void: the persisted branch's reload must be awaited or the discarded task leaves
    /// _loading stuck true with nothing to repaint it (and swallows its exceptions with it).</summary>
    private async Task Cancel()
    {
        if (_model?.IsDirty == true)
        {
            if (_navPromptOpen) return; // a prompt is already up — don't stack a second one

            _navPromptOpen = true;
            string? choice;
            try
            {
                choice = await ShowUnsavedDialogAsync();
            }
            finally
            {
                _navPromptOpen = false;
            }

            if (choice is null || choice == "cancel") return; // stay on the form, edits intact

            if (choice == "save")
            {
                var uid = await SaveInternalAsync();
                if (uid is null) return; // save failed → stay, exactly as the dirty guard does

                // A nested child saved from this prompt must link into the parent just as the
                // Save button would (RD19) — the same rule OnLocationChanging applies.
                if (Stack.HasFrames)
                {
                    CommitChildAndReturn(uid);
                    return;
                }
            }

            // "discard", or a save with nothing left to link → fall through to Cancel's normal
            // destination below. Note the model still reads dirty after a Create save (RD13),
            // so the navigating branches' existing suppression is what keeps it from re-prompting.
        }

        if (Stack.HasFrames)
        {
            // Discarding a nested child: pop back to the parent, linking nothing (Returned stays null).
            _suppressNavGuard = true;
            Navigation.NavigateTo(Stack.Peek().ParentRoute);
        }
        else if (_model?.IsPersisted == true)
        {
            _mode = "View";
            await LoadAsync(forceReload: true); // discard in-memory edits, reload the persisted values
        }
        else
        {
            _suppressNavGuard = true;
            Navigation.NavigateTo("/");
        }
    }

    private void OnGeneralFieldChanged()
    {
        if (_model is null) return;

        _model.IdentityPreview.Domain = _model.Domain.EditedValue;
        _model.IdentityPreview.ResourceType = _model.ResourceType.EditedValue;
        _model.IdentityPreview.Key = _model.Key.EditedValue;

        // Any identity-bearing field change invalidates the last uniqueness result.
        _model.IdentityPreview.IsUnique = null;
        _model.IdentityPreview.UniquenessMessage = null;

        StateHasChanged();
    }

    private void OnResourceTypeChanged(int? resourceTypeId)
    {
        if (_model is null || _response is null || _model.IsPersisted) return;

        // Drop existing pre-seeded rows (a value the user typed before switching type is lost —
        // accepted, RD6); keep user-added rows.
        _model.Tags = _model.Tags.Where(t => !t.IsPreSeeded).ToList();

        if (resourceTypeId is null)
        {
            StateHasChanged();
            return;
        }

        var templates = _response.EntryPointTemplates.Where(t => t.ResourceTypeId == resourceTypeId).ToList();
        var newDefaultPrimaryId = templates.FirstOrDefault(t => t.IsDefaultPrimary)?.TagDefinitionId;

        foreach (var template in templates)
        {
            if (_model.Tags.Any(t => t.TagDefinitionId == template.TagDefinitionId)) continue;

            var definition = _response.TagDictionary.FirstOrDefault(d => d.TagDefinitionId == template.TagDefinitionId);
            if (definition is null || definition.IsDomainTag) continue;

            _model.Tags.Add(new TagRowEditor
            {
                Definition = definition,
                TagDefinitionId = definition.TagDefinitionId,
                Values = new List<SingleValueEditor>(),
                IsPrimary = template.IsDefaultPrimary,
                IsPreSeeded = true
            });
        }

        if (newDefaultPrimaryId is not null)
        {
            foreach (var t in _model.Tags)
                t.IsPrimary = t.TagDefinitionId == newDefaultPrimaryId;
            _model.PrimaryTagDefinitionId = newDefaultPrimaryId;
        }

        StateHasChanged();
    }

    private void OnResourceDomainChanged()
    {
        if (_model is null || _model.IsPersisted) return;

        // RD6: rows added under the old domain could now be cross-domain — clear both
        // directions rather than leave stale, now-invalid dependency rows.
        _model.DependsOn.Clear();
        _model.DependentOn.Clear();

        StateHasChanged();
    }

    private async Task CheckUniquenessAsync()
    {
        if (_model is null) return;
        try
        {
            var request = new ResourceUniquenessRequest
            {
                ResourceTypeId = _model.ResourceTypeId ?? 0,
                Domain = _model.Domain.EditedValue,
                ResourceKey = _model.Key.EditedValue,
                ExcludeResourceUid = _model.IsPersisted ? _model.ResourceUid : null
            };

            var response = await ResourceService.CheckUniquenessAsync(request, CancellationToken.None);
            if (response.IsSuccess() && response.ApiResponse.Data is not null)
            {
                _model.IdentityPreview.IsUnique = response.ApiResponse.Data.IsUnique;
                _model.IdentityPreview.UniquenessMessage = response.ApiResponse.Data.Message;
            }
        }
        catch
        {
            // Non-critical — the server re-validates on Save regardless.
        }
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        var savedUid = await SaveInternalAsync();
        if (savedUid is null) return;

        if (Stack.HasFrames)
        {
            CommitChildAndReturn(savedUid);
            return;
        }

        if (string.Equals(ResourceUid, savedUid, StringComparison.Ordinal))
        {
            // Edit-mode save on the same route — reload fresh and drop back to View.
            _mode = "View";
            await LoadAsync(forceReload: true);
        }
        else
        {
            // Create-mode save — move to the resource's permalink; OnParametersSetAsync loads it.
            // The model is still (harmlessly) "dirty" per IsChanged bookkeeping even though the
            // save just succeeded (nothing resets OriginalValue), so this navigation must suppress
            // the guard itself (RD13) or it would prompt "unsaved changes?" on every Create save.
            _suppressNavGuard = true;
            Navigation.NavigateTo($"/resources/{savedUid}", replace: true);
        }
    }

    /// <summary>Validates + persists the current model. Returns the saved uid, or null on
    /// validation/server failure. Never navigates — callers (the Save button, the dirty guard's
    /// save choice) own the follow-on navigation (RD13).</summary>
    private async Task<string?> SaveInternalAsync()
    {
        if (_model is null) return null;

        var generalValid = EditorValidation.ValidateGeneral(_model);
        var tagsValid = EditorValidation.ValidateTags(_model);
        if (!generalValid || !tagsValid)
        {
            Snackbar.Add("Fix the highlighted fields before saving.", Severity.Warning);
            return null;
        }

        _saving = true;
        try
        {
            var flattenedTags = FlattenTags(_model);
            var request = new SaveResourceRequest
            {
                Mode = _model.IsPersisted ? "Edit" : "Create",
                ResourceUid = _model.ResourceUid,
                ResourceTypeId = _model.ResourceTypeId ?? 0,
                Domain = _model.Domain.EditedValue,
                ResourceName = _model.Name.EditedValue,
                ResourceKey = _model.Key.EditedValue,
                Description = _model.Description.EditedValue,
                PrimaryTagDefinitionId = ResolveEffectivePrimary(_model, flattenedTags),
                Tags = flattenedTags,
                DependsOnUids = FlattenDependencyUids(_model.DependsOn),
                DependentOnUids = FlattenDependencyUids(_model.DependentOn)
            };

            var response = await ResourceService.SaveResourceAsync(request, CancellationToken.None);
            if (response.IsSuccess() && response.ApiResponse.Data is not null)
            {
                Snackbar.Add(response.ApiResponse.Data.Message, Severity.Success);
                return response.ApiResponse.Data.ResourceUid;
            }

            ApplyServerErrors(response);
            Snackbar.Add("Could not save — see the highlighted fields.", Severity.Warning);
            return null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
            return null;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>The single pop-back-with-link path (RD8): the child is already fully persisted
    /// (a plain Create); the parent gets only an in-memory dependency row — the edge itself
    /// persists on the parent's own next Save.</summary>
    private void CommitChildAndReturn(string uid)
    {
        if (_model is null) return;
        var frame = Stack.Peek();
        frame.Returned = new ReturnedChild
        {
            ResourceUid = uid,
            Name = _model.Name.EditedValue,
            TypeName = _model.ResourceType.EditedValue,
            Domain = _model.Domain.EditedValue
        };
        _suppressNavGuard = true;
        Navigation.NavigateTo(frame.ParentRoute);
    }

    private static List<SaveTagValue> FlattenTags(ResourceEditorModel model)
    {
        var result = new List<SaveTagValue>();
        foreach (var row in model.Tags.Where(t => !t.IsRemoved))
        {
            foreach (var value in row.Values.Where(v => !string.IsNullOrWhiteSpace(v.EditedValue)))
            {
                result.Add(new SaveTagValue
                {
                    TagDefinitionId = row.TagDefinitionId,
                    TagDefinitionKey = row.Definition.TagDefinitionKey,
                    Value = value.EditedValue
                });
            }
        }
        return result;
    }

    private static List<string> FlattenDependencyUids(List<DependencyRowEditor> rows) =>
        rows.Where(r => !r.IsRemoved).Select(r => r.OtherResourceUid).Distinct().ToList();

    // RD2: only send a primary when its row is a Link tag with a non-empty value that
    // survives this save (an emptied/removed primary row must clear the primary).
    private static int? ResolveEffectivePrimary(ResourceEditorModel model, List<SaveTagValue> flattenedTags)
    {
        if (model.PrimaryTagDefinitionId is null) return null;

        var primaryRow = model.Tags.FirstOrDefault(t => !t.IsRemoved && t.TagDefinitionId == model.PrimaryTagDefinitionId);
        if (primaryRow is null || !primaryRow.IsLink) return null;

        var survives = flattenedTags.Any(t => t.TagDefinitionId == model.PrimaryTagDefinitionId);
        return survives ? model.PrimaryTagDefinitionId : null;
    }

    private void ApplyServerErrors(ApiServiceResponse<SaveResourceResponse> response)
    {
        if (_model is null) return;
        foreach (var error in response.ApiResponse.Errors ?? new List<Message>())
        {
            var message = error.Details ?? error.Title ?? "Invalid";
            var target = error.PropertyName switch
            {
                "request.ResourceTypeId" => _model.ResourceType,
                "request.Domain" => _model.Domain,
                "request.ResourceName" => _model.Name,
                "request.ResourceKey" => _model.Key,
                _ => null
            };

            if (target is not null)
            {
                target.Messages.Add(new EditorMessage { Message = message, Level = EditorFieldLevel.Error });
            }
            else if (string.Equals(error.PropertyName, "request.Tags", StringComparison.Ordinal)
                     || string.Equals(error.PropertyName, "request.DependsOnUids", StringComparison.Ordinal)
                     || string.Equals(error.PropertyName, "request.DependentOnUids", StringComparison.Ordinal))
            {
                // Server-side tag/relationship validation is a defense backstop (the client
                // already validates via the picker), so surface it directly rather than trying
                // to map it to a row.
                Snackbar.Add(message, Severity.Error);
            }
        }
    }

    private async Task DeleteAsync()
    {
        if (_model is null) return;

        var dependents = _model.DependentOn.Where(d => !d.IsRemoved).Select(d => d.OtherResourceName).ToList();
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDeleteDialog.ResourceName), _model.Name.EditedValue },
            { nameof(ConfirmDeleteDialog.Dependents), dependents }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete resource", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        _deleting = true;
        try
        {
            var deletedName = _model.Name.EditedValue;
            var response = await ResourceService.DeleteResourceAsync(_model.ResourceUid, CancellationToken.None);
            if (response.IsSuccess())
            {
                Snackbar.Add($"Deleted {deletedName}", Severity.Success);
                _suppressNavGuard = true; // deleting is a leave (RD16) — the resource is gone, don't dirty-prompt
                Navigation.NavigateTo("/");
            }
            else
            {
                Snackbar.Add("Could not delete — it may already be gone.", Severity.Error);
            }
        }
        finally
        {
            _deleting = false;
        }
    }

    /// <summary>Dirty guard (RD1): always PreventNavigation first, then show the Save/Discard/
    /// Cancel dialog, then re-NavigateTo the target on confirm. Awaiting a dialog BEFORE
    /// preventing risks the navigation committing (especially browser Back) while it's still open.</summary>
    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_suppressNavGuard)
        {
            _suppressNavGuard = false; // one-shot: consume this intentional navigation
            return;
        }

        if (_mode == "View" || _model is null || !_model.IsDirty) return;

        if (_navPromptOpen)
        {
            context.PreventNavigation(); // a prompt is already up — hold this second nav too
            return;
        }

        context.PreventNavigation();
        var target = context.TargetLocation;

        _navPromptOpen = true;
        string? choice;
        try
        {
            choice = await ShowUnsavedDialogAsync();
        }
        finally
        {
            _navPromptOpen = false;
        }

        if (choice is null || choice == "cancel") return; // stay put — already prevented

        if (choice == "save")
        {
            var uid = await SaveInternalAsync();
            if (uid is null) return; // save failed → stay

            // A nested child saved via the back-prompt (rather than the Save button) must still
            // link into the parent exactly as the button would (RD19).
            if (Stack.HasFrames && string.Equals(NormalizeRoute(target), Stack.Peek().ParentRoute, StringComparison.Ordinal))
            {
                CommitChildAndReturn(uid);
                return;
            }
        }

        _suppressNavGuard = true; // discard, or a save with nothing more to link → let the re-nav through
        Navigation.NavigateTo(target);
    }

    private async Task<string?> ShowUnsavedDialogAsync()
    {
        var name = string.IsNullOrWhiteSpace(_model?.Name.EditedValue) ? "this resource" : _model!.Name.EditedValue;
        var parameters = new DialogParameters { { nameof(UnsavedChangesDialog.ResourceName), name } };
        var dialog = await DialogService.ShowAsync<UnsavedChangesDialog>("Unsaved changes", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return "cancel"; // dismissed unexpectedly → fail safe, stay put
        return result.Data as string;
    }
}
