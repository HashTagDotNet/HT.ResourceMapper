@using ResourceMapper.Common.Shared.Editor
@inject IDialogService DialogService

@if (Row.Definition.IsMultiValued)
{
    <div class="rm-tag-multivalue">
        <MudChipSet T="string" Class="rm-tag-chipset">
            @foreach (var v in ActiveValues())
            {
                @* Each value carries its own copy affordance: the multi-valued tags are Runbook and
                   Documentation, i.e. exactly the URLs worth copying. Revealed on row hover (see
                   .rm-copybtn) with :focus-within for keyboard and a coarse-pointer fallback, so
                   hiding it does not make it unreachable on touch (PL-12c). *@
                <span class="rm-tag-chipwrap">
                    <MudChip T="string" Value="@v.EditedValue" OnClose="@(() => RemoveValue(v))" Disabled="@ReadOnlyEffective">@v.EditedValue</MudChip>
                    <CopyValueButton Value="@v.EditedValue" Label="@Row.Definition.DisplayName" />
                </span>
            }
        </MudChipSet>
        @if (!ReadOnlyEffective)
        {
            @* PL-20: this in-row control is how a multi-valued tag takes more than one value —
               it was being missed, so the placeholder names that explicitly once a value exists. *@
            @if (Row.IsControlledVocab)
            {
                <MudSelect T="string" @key="_vocabSelectKey" Value="@_pendingValue" ValueChanged="OnPendingVocabSelected"
                           Placeholder="@AddValuePlaceholder" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var opt in AvailableVocabValues())
                    {
                        <MudSelectItem Value="@opt">@opt</MudSelectItem>
                    }
                </MudSelect>
                @AddChoiceLink
            }
            else
            {
                <div class="d-flex align-center rm-tag-add-row">
                    <MudTextField T="string" @bind-Value="_pendingValue" Placeholder="@AddValuePlaceholder"
                                  Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                    <MudTooltip Text="Add this value to the tag">
                        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Primary"
                                       aria-label="Add this value to the tag"
                                       Disabled="@string.IsNullOrWhiteSpace(_pendingValue)" OnClick="AddPendingValue" />
                    </MudTooltip>
                </div>
            }
        }
    </div>
}
else
{
    var editor = EnsureSingleValue();
    @* One copy affordance per value, rendered BESIDE the control rather than as an end adornment
       inside it. An in-field adornment was the first attempt (the literal GitHub treatment) but it
       is unclickable on the read-only details view: MudBlazor's `mud-disabled` input div intercepts
       pointer events, so the icon appeared and did nothing. Rendering it outside also means one
       mechanism covers text, link, vocab-select and chip rows alike, instead of the select being
       silently excluded because its adornment slot is taken by the dropdown arrow. *@
    <div class="rm-tag-valuewrap">
        @if (Row.IsLink)
        {
            <MudTextField T="string" Value="@editor.EditedValue" ValueChanged="@(v => OnSingleValueChanged(editor, v))"
                          Placeholder="https://…" Disabled="@ReadOnlyEffective" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Error="@(!string.IsNullOrWhiteSpace(editor.EditedValue) && !IsValidLink(editor.EditedValue))"
                          ErrorText="Must be a valid http/https URL" />
        }
        else if (Row.IsControlledVocab)
        {
            <MudSelect T="string" Value="@editor.EditedValue" ValueChanged="@(v => OnSingleValueChanged(editor, v))"
                       Placeholder="Select…" Disabled="@ReadOnlyEffective" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var opt in Row.Definition.AllowedValues ?? new List<string>())
                {
                    <MudSelectItem Value="@opt">@opt</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudTextField T="string" Value="@editor.EditedValue" ValueChanged="@(v => OnSingleValueChanged(editor, v))"
                          Disabled="@ReadOnlyEffective" Variant="Variant.Outlined" Margin="Margin.Dense" />
        }

        <CopyValueButton Value="@editor.EditedValue" Label="@Row.Definition.DisplayName" />
    </div>

    @* Outside .rm-tag-valuewrap deliberately: that wrapper is a flex ROW (it keeps the copy button
       beside the value), so anything inside it lands to the RIGHT of the select. The add action
       belongs under the field it extends. *@
    @if (Row.IsControlledVocab && !ReadOnlyEffective)
    {
        @AddChoiceLink
    }
}

@code {
    [Parameter] public TagRowEditor Row { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _pendingValue;
    private int _vocabSelectKey;

    /// <summary>
    /// The FK gap both vocab pickers had: a controlled list with no way to extend it, so hitting a
    /// value the list did not offer meant abandoning the resource and going to the tag screen. One
    /// fragment, rendered under whichever of the two selects is in play, so the single- and
    /// multi-value rows cannot drift apart. Named after the field so it reads as being about this
    /// row, not about tags generally.
    /// </summary>
    private RenderFragment AddChoiceLink => __builder =>
    {
        <div class="rm-fk-action">
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add"
                       OnClick="OpenAddChoiceDialog" Class="rm-tag-add-choice">
                Add @FieldLabel…
            </MudButton>
        </div>
    };

    private string FieldLabel =>
        string.IsNullOrWhiteSpace(Row.Definition.DisplayName)
            ? Row.Definition.TagDefinitionKey
            : Row.Definition.DisplayName!;

    private bool ReadOnlyEffective => ReadOnly || !Row.IsEditable;

    /// <summary>Names the multi-value affordance for what it is once the row already holds a
    /// value — "Add value…" alone read as the row's only input, so the ability to hold several
    /// values in one row was being missed.</summary>
    private string AddValuePlaceholder => ActiveValues().Any() ? "Add another value…" : "Add value…";

    private SingleValueEditor EnsureSingleValue()
    {
        if (Row.Values.Count == 0)
            Row.Values.Add(new SingleValueEditor { OriginalValue = string.Empty, EditedValue = string.Empty });
        return Row.Values[0];
    }

    private IEnumerable<SingleValueEditor> ActiveValues() =>
        Row.Values.Where(v => !string.IsNullOrWhiteSpace(v.EditedValue));

    private IEnumerable<string> AvailableVocabValues()
    {
        var active = new HashSet<string>(ActiveValues().Select(v => v.EditedValue), StringComparer.Ordinal);
        return (Row.Definition.AllowedValues ?? new List<string>()).Where(o => !active.Contains(o));
    }

    private async Task OnSingleValueChanged(SingleValueEditor editor, string value)
    {
        editor.EditedValue = value ?? string.Empty;
        StateHasChanged();
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveValue(SingleValueEditor value)
    {
        Row.Values.Remove(value);
        await OnChanged.InvokeAsync();
    }

    private async Task OnPendingVocabSelected(string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            Row.Values.Add(new SingleValueEditor { OriginalValue = string.Empty, EditedValue = value });
        _pendingValue = null;
        _vocabSelectKey++; // force the select to remount so it visually resets to the placeholder
        await OnChanged.InvokeAsync();
    }

    private async Task AddPendingValue()
    {
        if (string.IsNullOrWhiteSpace(_pendingValue)) return;
        Row.Values.Add(new SingleValueEditor { OriginalValue = string.Empty, EditedValue = _pendingValue });
        _pendingValue = null;
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Adds a choice to this tag's vocabulary and selects it into the row that asked — for a
    /// multi-value row that means appending it as a chip, for a single-value row replacing the
    /// current selection. Definition.AllowedValues is refreshed from the server's copy so the
    /// dropdown offers the new value immediately, without reloading the editor and losing the
    /// user's other unsaved edits.
    /// </summary>
    private async Task OpenAddChoiceDialog()
    {
        var parameters = new DialogParameters
        {
            { nameof(AllowedValueDialog.TagDefinitionId), Row.Definition.TagDefinitionId },
            { nameof(AllowedValueDialog.FieldLabel), FieldLabel },
            { nameof(AllowedValueDialog.ExistingValues), (Row.Definition.AllowedValues ?? new List<string>()).ToList() }
        };

        var dialog = await DialogService.ShowAsync<AllowedValueDialog>($"Add {FieldLabel}", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is not AllowedValueDialog.AllowedValueResult added) return;

        Row.Definition.AllowedValues = added.Definition.AllowedValues ?? new List<string>();

        if (Row.Definition.IsMultiValued)
        {
            Row.Values.Add(new SingleValueEditor { OriginalValue = string.Empty, EditedValue = added.Value });
            _pendingValue = null;
            _vocabSelectKey++; // the pending select has to remount or it keeps showing the old text (PL-16)
        }
        else
        {
            EnsureSingleValue().EditedValue = added.Value;
        }

        await OnChanged.InvokeAsync();
    }

    private static bool IsValidLink(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
               && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }
}
