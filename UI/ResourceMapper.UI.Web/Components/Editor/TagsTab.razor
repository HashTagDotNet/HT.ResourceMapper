@using ResourceMapper.Common.Shared.Editor
@using ResourceMapper.Common.Shared.Editor.Contracts
@using ResourceMapper.Common.Server.Resources.Interfaces
@inject IResourceService ResourceService
@inject IDialogService DialogService

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    Tags carry a resource's links and metadata. Fill in the ones that apply; empty rows are
    dropped when you save. Only one Link tag can be the primary (the click-through link).
</MudText>

<MudRadioGroup T="int?" Value="@Model.PrimaryTagDefinitionId" ValueChanged="OnPrimaryRadioChanged">
    <div class="rm-tags-editor">
        @foreach (var row in VisibleRows())
        {
            <div class="rm-tag-row">
                <div class="rm-tag-label">
                    @row.Definition.DisplayName
                    @if (row.IsRequired)
                    {
                        <span class="rm-tag-required">*</span>
                    }
                    @if (row.IsSuggested)
                    {
                        <MudTooltip Text="Suggested">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="ml-1" />
                        </MudTooltip>
                    }
                </div>
                <div class="rm-tag-value">
                    <TagValueEditor Row="row" ReadOnly="ReadOnly" OnChanged="OnRowChanged" />
                </div>
                <div class="rm-tag-primary">
                    @if (row.CanBePrimary && !ReadOnly)
                    {
                        <MudRadio T="int?" Value="@((int?)row.TagDefinitionId)" Color="Color.Primary" />
                    }
                    else if (row.IsPrimary)
                    {
                        <MudTooltip Text="Primary link">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Primary" />
                        </MudTooltip>
                    }
                </div>
                <div class="rm-tag-remove">
                    @if (!ReadOnly)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="@(() => RemoveRow(row))" />
                    }
                </div>
            </div>
            @foreach (var msg in row.RowMessages)
            {
                <MudAlert Severity="@(msg.Level == EditorFieldLevel.Error ? Severity.Error : Severity.Warning)"
                          Variant="Variant.Outlined" Dense="true" Class="mb-2">@msg.Message</MudAlert>
            }
        }
    </div>
</MudRadioGroup>

@if (!ReadOnly)
{
    <div class="d-flex align-center mt-3 rm-tag-add">
        @* PL-20: the "add existing" search is hidden outright when every applicable definition is
           already on the form — slice #7 pre-seeds a row per applicable tag, so an always-empty
           dropdown reads as broken. Create-new stays: a brand-new definition is always addable. *@
        @if (HasAddableTags)
        {
            <MudAutocomplete T="TagDefinitionModel" @key="_addTagKey" Value="null" ValueChanged="OnAddExistingTag"
                              SearchFunc="SearchAddableTags" ToStringFunc="@(t => t?.DisplayName ?? t?.TagDefinitionKey ?? string.Empty)"
                              Placeholder="Add existing tag…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Clearable="true" ResetValueOnEmptyText="true" CoerceValue="false" Class="rm-tag-add-search" />
        }
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreateDialog"
                   Class="@(HasAddableTags ? "ml-2" : string.Empty)">
            Create new tag…
        </MudButton>
    </div>
}

@code {
    [Parameter] public ResourceEditorModel Model { get; set; } = default!;
    [Parameter] public List<TagDefinitionModel> TagDictionary { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnFieldChanged { get; set; }

    private int _addTagKey;

    private List<TagRowEditor> VisibleRows() => Model.Tags.Where(t => !t.IsRemoved).ToList();

    /// <summary>True when at least one definition is still addable, i.e. the add-existing search
    /// has something to offer. Evaluated at render time so the control disappears as soon as the
    /// last candidate is added and reappears when a row is removed.</summary>
    private bool HasAddableTags => AddableTags().Any();

    private async Task OnRowChanged() => await OnFieldChanged.InvokeAsync();

    private async Task OnPrimaryRadioChanged(int? tagDefinitionId)
    {
        foreach (var t in Model.Tags)
            t.IsPrimary = t.TagDefinitionId == tagDefinitionId;
        Model.PrimaryTagDefinitionId = tagDefinitionId;
        await OnFieldChanged.InvokeAsync();
    }

    private async Task RemoveRow(TagRowEditor row)
    {
        // A row with a persisted original value must stay (flagged IsRemoved) so IsDirty/save
        // can see the removal; a never-persisted row (fresh pre-seed or added this session) can
        // just vanish.
        var wasPersisted = row.Values.Any(v => !string.IsNullOrWhiteSpace(v.OriginalValue));
        if (wasPersisted)
        {
            row.IsRemoved = true;
        }
        else
        {
            Model.Tags.Remove(row);
        }

        if (Model.PrimaryTagDefinitionId == row.TagDefinitionId)
            Model.PrimaryTagDefinitionId = null;

        await OnFieldChanged.InvokeAsync();
    }

    /// <summary>Definitions not already on the form, excluding the domain tag and system tags —
    /// the same set the add-existing search offers. Multi-value lives *inside* a row as chips, so
    /// an already-present definition is deliberately not a candidate a second time.</summary>
    private IEnumerable<TagDefinitionModel> AddableTags()
    {
        var existingIds = new HashSet<int>(Model.Tags.Where(t => !t.IsRemoved).Select(t => t.TagDefinitionId));
        var domainId = TagDictionary.FirstOrDefault(t => t.IsDomainTag)?.TagDefinitionId;

        return TagDictionary
            .Where(t => !existingIds.Contains(t.TagDefinitionId)
                        && t.TagDefinitionId != domainId
                        && !t.IsSystemTag)
            .OrderBy(t => t.DisplayOrder)
            .ThenBy(t => t.TagDefinitionKey);
    }

    private Task<IEnumerable<TagDefinitionModel>> SearchAddableTags(string search, CancellationToken cancellationToken)
    {
        var candidates = AddableTags();

        if (!string.IsNullOrWhiteSpace(search))
        {
            candidates = candidates.Where(t =>
                (t.DisplayName ?? t.TagDefinitionKey).Contains(search, StringComparison.OrdinalIgnoreCase)
                || t.TagDefinitionKey.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(candidates);
    }

    private async Task OnAddExistingTag(TagDefinitionModel? definition)
    {
        if (definition == null) return;
        AddRowForDefinition(definition);
        _addTagKey++; // PL-16: force the autocomplete to remount so it visually resets to the placeholder
        await OnFieldChanged.InvokeAsync();
    }

    private void AddRowForDefinition(TagDefinitionModel definition)
    {
        Model.Tags.Add(new TagRowEditor
        {
            Definition = definition,
            TagDefinitionId = definition.TagDefinitionId,
            Values = new List<SingleValueEditor>(),
            IsPrimary = false,
            IsPreSeeded = false
        });
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { nameof(TagDefinitionDialog.ExistingKeys), TagDictionary.Select(t => t.TagDefinitionKey).ToList() }
        };
        var dialog = await DialogService.ShowAsync<TagDefinitionDialog>("Create tag definition", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (result.Data is TagDefinitionModel created)
        {
            if (!TagDictionary.Any(t => t.TagDefinitionId == created.TagDefinitionId))
                TagDictionary.Add(created);

            if (!Model.Tags.Any(t => t.TagDefinitionId == created.TagDefinitionId && !t.IsRemoved))
                AddRowForDefinition(created);

            await OnFieldChanged.InvokeAsync();
        }
    }
}
