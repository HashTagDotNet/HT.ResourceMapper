@using ResourceMapper.Common.Shared.Editor

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    Review before saving. The record isn't saved until Save succeeds.
</MudText>

@* Every row ends in a copy cell, revealed on row hover (see .rm-copybtn in app.css). The cell is
   always present even where there is no value, so the value column keeps one consistent width down
   the table instead of jogging on the rows that happen to be empty. *@
<MudSimpleTable Dense="true" Elevation="0" Class="rm-review-table" Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
    <tbody>
        @ReviewRow("Resource Type", Model.ResourceType.EditedValue)
        @ReviewRow("Domain", Model.Domain.EditedValue)
        @ReviewRow("Name", Model.Name.EditedValue)
        @ReviewRow("Key", Model.Key.EditedValue)
        @ReviewRow("Description", Model.Description.EditedValue)
        @ReviewRow("Identity", Model.IdentityPreview.Display)
    </tbody>
</MudSimpleTable>

<MudSimpleTable Dense="true" Elevation="0" Class="mt-3 rm-review-table" Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
    <thead>
        <tr><th colspan="3">Tags</th></tr>
    </thead>
    <tbody>
        @{
            var visibleTags = VisibleTags();
        }
        @if (visibleTags.Count == 0)
        {
            <tr><td colspan="3" class="rm-review-label">No tags set.</td></tr>
        }
        else
        {
            @foreach (var row in visibleTags)
            {
                var value = RowValueDisplay(row);
                <tr>
                    <td class="rm-review-label">
                        @row.Definition.DisplayName
                        @if (row.IsPrimary)
                        {
                            @* PL-35: the star carried no explanation at all — Steve designed it and
                               could not recall what it meant. Same wording as the Tags tab's star. *@
                            <MudTooltip Text="@PrimaryLinkTooltip">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                         Color="Color.Inherit" Class="ml-1 rm-primary-star" />
                            </MudTooltip>
                        }
                    </td>
                    <td>@value</td>
                    <td class="rm-review-copy"><CopyValueButton Value="@value" Label="@row.Definition.DisplayName" /></td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

<MudSimpleTable Dense="true" Elevation="0" Class="mt-3 rm-review-table" Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
    <thead>
        <tr><th colspan="3">Dependencies</th></tr>
    </thead>
    <tbody>
        @{
            var dependsOn = VisibleDependencies(Model.DependsOn);
        }
        @if (dependsOn.Count == 0)
        {
            <tr><td colspan="3" class="rm-review-label">No dependencies set.</td></tr>
        }
        else
        {
            @foreach (var row in dependsOn)
            {
                <tr>
                    <td class="rm-review-label">@row.OtherResourceName</td>
                    <td>@row.OtherResourceType</td>
                    @* These rows are (name, type) pairs rather than label/value, so copy takes the
                       resource NAME — the identifying half, and the thing worth pasting into search. *@
                    <td class="rm-review-copy"><CopyValueButton Value="@row.OtherResourceName" Label="dependency" /></td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

<MudSimpleTable Dense="true" Elevation="0" Class="mt-3 rm-review-table" Style="border:1px solid var(--mud-palette-divider);border-radius:8px;">
    <thead>
        <tr><th colspan="3">Dependent On</th></tr>
    </thead>
    <tbody>
        @{
            var dependentOn = VisibleDependencies(Model.DependentOn);
        }
        @if (dependentOn.Count == 0)
        {
            <tr><td colspan="3" class="rm-review-label">No dependents set.</td></tr>
        }
        else
        {
            @foreach (var row in dependentOn)
            {
                <tr>
                    <td class="rm-review-label">@row.OtherResourceName</td>
                    <td>@row.OtherResourceType</td>
                    <td class="rm-review-copy"><CopyValueButton Value="@row.OtherResourceName" Label="dependent" /></td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

@{
    var messages = CollectMessages();
}
@if (messages.Count > 0)
{
    <div class="mt-3">
        @foreach (var message in messages)
        {
            <MudAlert Severity="@(message.Level == EditorFieldLevel.Error ? Severity.Error : Severity.Warning)"
                      Variant="Variant.Outlined" Dense="true" Class="mb-2">
                @message.Field: @message.Text
            </MudAlert>
        }
    </div>
}
else
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
        Ready to save.
    </MudAlert>
}

@code {
    [Parameter] public ResourceEditorModel Model { get; set; } = default!;

    /// <summary>
    /// Shared with the Tags tab's star so the same symbol never carries two different explanations.
    /// Names the concept AND what it does — "Primary link" alone was the wording that PL-35 records
    /// as unmemorable even to its author.
    /// </summary>
    internal const string PrimaryLinkTooltip = "Primary link — the resource's click-through link";

    /// <summary>
    /// One label/value/copy row. Renders an em dash for a blank value and, via CopyValueButton,
    /// no copy affordance at all in that case.
    /// </summary>
    private RenderFragment ReviewRow(string label, string? value) =>
        @<tr>
            <td class="rm-review-label">@label</td>
            <td>@(string.IsNullOrEmpty(value) ? "—" : value)</td>
            <td class="rm-review-copy"><CopyValueButton Value="@value" Label="@label" /></td>
        </tr>;

    private List<(string Field, string Text, EditorFieldLevel Level)> CollectMessages()
    {
        var result = new List<(string, string, EditorFieldLevel)>();
        AddFieldMessages("Resource Type", Model.ResourceType, result);
        AddFieldMessages("Domain", Model.Domain, result);
        AddFieldMessages("Name", Model.Name, result);
        AddFieldMessages("Key", Model.Key, result);

        foreach (var row in Model.Tags.Where(t => !t.IsRemoved))
        {
            var label = row.Definition.DisplayName ?? row.Definition.TagDefinitionKey;
            foreach (var m in row.RowMessages)
                result.Add((label, m.Message ?? string.Empty, m.Level));
        }

        return result;
    }

    private static void AddFieldMessages(string field, SingleValueEditor editor, List<(string, string, EditorFieldLevel)> result)
    {
        foreach (var m in editor.Messages)
            result.Add((field, m.Message ?? string.Empty, m.Level));
    }

    private List<TagRowEditor> VisibleTags() =>
        Model.Tags.Where(t => !t.IsRemoved && t.Values.Any(v => !string.IsNullOrWhiteSpace(v.EditedValue))).ToList();

    private static string RowValueDisplay(TagRowEditor row) =>
        string.Join(", ", row.Values.Where(v => !string.IsNullOrWhiteSpace(v.EditedValue)).Select(v => v.EditedValue));

    private static List<DependencyRowEditor> VisibleDependencies(List<DependencyRowEditor> rows) =>
        rows.Where(r => !r.IsRemoved).ToList();
}
