@using ResourceMapper.Common.Shared.Editor.Contracts
@using ResourceMapper.Common.Server.Resources.Interfaces
@inject IResourceService ResourceService

@if (string.IsNullOrWhiteSpace(Domain))
{
    <MudText Typo="Typo.caption" Color="Color.Secondary">Choose a Subscription on the General tab first.</MudText>
}
else
{
    <MudAutocomplete T="ResourcePickerItem" @key="_pickerKey" Value="null" ValueChanged="OnItemPicked"
                      SearchFunc="SearchAsync" ToStringFunc="@FormatItem"
                      Placeholder="Add existing resource…" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Clearable="true" ResetValueOnEmptyText="true" CoerceValue="false" Class="rm-deps-picker">
        <NoItemsTemplate>
            <div class="pa-2 rm-picker-no-items">
                <MudText Typo="Typo.body2">No matching resources.</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="@(() => OnCreateNewRequested.InvokeAsync())" Class="mt-1 rm-picker-create-new">
                    Create new resource…
                </MudButton>
            </div>
        </NoItemsTemplate>
    </MudAutocomplete>
}

@code {
    [Parameter] public string? Domain { get; set; }
    [Parameter] public string? ExcludeResourceUid { get; set; }
    [Parameter] public List<string> ExcludedUids { get; set; } = new();
    [Parameter] public EventCallback<ResourcePickerItem> OnPicked { get; set; }

    /// <summary>Fired when the user asks to create a new target from the "no matches" state.</summary>
    [Parameter] public EventCallback OnCreateNewRequested { get; set; }

    private int _pickerKey;

    private static string FormatItem(ResourcePickerItem? item) =>
        item is null ? string.Empty : $"{item.ResourceName} · {item.ResourceTypeName} · {item.Domain}";

    private async Task<IEnumerable<ResourcePickerItem>> SearchAsync(string search, CancellationToken cancellationToken)
    {
        var request = new ResourcePickerRequest
        {
            SearchFor = search,
            Domain = Domain,
            ExcludeResourceUid = ExcludeResourceUid,
            Skip = 0,
            Take = 20
        };

        var response = await ResourceService.SearchResourcesForPickerAsync(request, cancellationToken);
        if (!response.IsSuccess() || response.ApiResponse.Data is null)
            return Enumerable.Empty<ResourcePickerItem>();

        return response.ApiResponse.Data.Items.Where(i => !ExcludedUids.Contains(i.ResourceUid));
    }

    private async Task OnItemPicked(ResourcePickerItem? item)
    {
        if (item is null) return;
        _pickerKey++; // PL-16: force the autocomplete to remount so it visually resets to the placeholder
        await OnPicked.InvokeAsync(item);
    }
}
