@using ResourceMapper.Common.Shared.Editor
@using ResourceMapper.Common.Shared.Editor.Contracts
@using ResourceMapper.Common.Server.Resources.Interfaces
@inject IResourceService ResourceService

<MudDialog>
    <DialogContent>
        @* PL-23 / design §7 (dialogs get the full treatment). This screen was the worst-affected by
           developer vocabulary: "Requirement Level → Error", the circular "Multi-valued (multiple
           discrete values)", an unexplained "Display Order", and the genuinely ambiguous pairing of
           "Allow custom value" with "Allowed Values". *@
        <div class="rm-section-desc">
            A tag definition describes a kind of metadata — its name, what sort of value it holds,
            and whether resources are expected to fill it in. Reuse beats duplication: if a tag with
            this name already exists, that one is used instead of a second copy.
        </div>

        <FormRow Label="Name" Required="true"
                 Info="What people see on the resource editor and in the grid's Tags column.">
            <MudTextField T="string" @bind-Value="_displayName" aria-label="Name"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="e.g. Owning Team, Runbook, Cost Center" />
        </FormRow>

        <FormRow Label="Key" Required="true"
                 Info="The stable internal identifier used by import and export. Not shown to users.">
            <MudTextField T="string" @bind-Value="_key" aria-label="Key" Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="@(KeyHelperText ?? "No spaces — e.g. OwningTeam")"
                          Error="@_keyError" ErrorText="Key is required" />
        </FormRow>

        <FormRow Label="Holds" Required="true"
                 Info="Link values render as clickable links and can be opened from the grid and the explorer. Text values are shown as-is.">
            <MudSelect T="string" @bind-Value="_contentType" aria-label="Holds"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="Pick Link for anything you would click — a portal URL, a runbook, a repo.">
                <MudSelectItem Value="@("Text")">Text</MudSelectItem>
                <MudSelectItem Value="@("Link")">A link (URL)</MudSelectItem>
            </MudSelect>
        </FormRow>

        @* Was "Requirement Level" with an "Error" option — the name of an internal severity, not
           anything a user would recognise. The stored values are unchanged; only the wording is. *@
        <FormRow Label="Expected?" Info="Controls whether a resource missing this tag is flagged when saving.">
            <MudSelect T="string" @bind-Value="_requirementLevel" aria-label="Expected"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="Required tags block saving until filled in.">
                <MudSelectItem Value="@("Error")">Required — can't save without it</MudSelectItem>
                <MudSelectItem Value="@("Suggested")">Recommended — flagged, but can still save</MudSelectItem>
                <MudSelectItem Value="@("Optional")">Optional — never flagged</MudSelectItem>
            </MudSelect>
        </FormRow>

        @* THE conceptual fix. "Allow custom value" and "Allowed Values" were two independent
           controls describing one decision, and their combinations included a state the app does not
           honour: with AllowCustomValue = true the editor renders a free-text box and ignores
           AllowedValues entirely (TagRowEditor.IsControlledVocab). Offering "suggestions, but other
           values allowed" would therefore have produced a list that never appears. Two options only,
           matching what the editor actually implements. *@
        <FormRow Label="Values" Info="Whether people type the value freely or choose from a list you define.">
            <MudRadioGroup T="bool" Value="_restrictToList" ValueChanged="OnRestrictChanged">
                <MudRadio T="bool" Value="false" Dense="true">Anything they type</MudRadio>
                <MudRadio T="bool" Value="true" Dense="true">Only values from a list</MudRadio>
            </MudRadioGroup>
        </FormRow>

        @if (_restrictToList)
        {
            <FormRow Label="The list" Required="true"
                     Info="These become the only choices offered for this tag. Editing the list later does not change values already saved.">
                <MudTextField T="string" @bind-Value="_allowedValuesCsv" aria-label="The list"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="Separate with commas — e.g. tier-1, tier-2, tier-3" />
            </FormRow>
        }

        <FormRow Label="How many" Info="Whether one resource can carry several values for this tag at once.">
            <MudRadioGroup T="bool" Value="_isMultiValued" ValueChanged="@(v => _isMultiValued = v)">
                <MudRadio T="bool" Value="false" Dense="true">One value</MudRadio>
                <MudRadio T="bool" Value="true" Dense="true">Several values</MudRadio>
            </MudRadioGroup>
        </FormRow>

        @* Was a bare "Display Order" number with no explanation of what it ordered. *@
        <FormRow Label="Sort position" Info="Where this tag sits in the list of tags on the resource editor.">
            <MudNumericField T="int" @bind-Value="_displayOrder" aria-label="Sort position"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             HelperText="Lower numbers appear first. Leave at 1000 to sort after the built-ins." />
        </FormRow>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_saving">
            @(_saving ? "Creating…" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<string> ExistingKeys { get; set; } = new();

    private string _key = string.Empty;
    private string? _displayName;
    private string _contentType = "Text";
    private string _requirementLevel = "Optional";
    private bool _isMultiValued;
    private string? _allowedValuesCsv;
    private int _displayOrder = 1000;
    private bool _saving;
    private bool _keyError;
    private string? _error;

    /// <summary>
    /// PL-23: the single decision that replaced the "Allow custom value" checkbox plus the
    /// "Allowed Values" text box. `false` = free text (no list, custom allowed); `true` = the list
    /// is the only choice. Maps onto AllowCustomValue = !_restrictToList, which is exactly the
    /// condition TagRowEditor.IsControlledVocab tests.
    /// </summary>
    private bool _restrictToList;

    /// <summary>Clearing the list when switching back to free text stops a stale list being saved
    /// against a definition that no longer uses one.</summary>
    private void OnRestrictChanged(bool value)
    {
        _restrictToList = value;
        if (!value) _allowedValuesCsv = null;
    }

    private string? KeyHelperText =>
        !string.IsNullOrWhiteSpace(_key) && ExistingKeys.Any(k => string.Equals(k, _key, StringComparison.OrdinalIgnoreCase))
            ? "A tag with this key already exists — that definition will be reused."
            : null;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        _error = null;
        _keyError = string.IsNullOrWhiteSpace(_key);
        if (_keyError) return;

        // "Only values from a list" with an empty list would save a definition that offers no
        // choices at all — an unfillable tag. Refuse rather than create it.
        if (_restrictToList && string.IsNullOrWhiteSpace(_allowedValuesCsv))
        {
            _error = "Add at least one value to the list, or choose \"Anything they type\".";
            return;
        }

        _saving = true;
        try
        {
            var allowedValues = string.IsNullOrWhiteSpace(_allowedValuesCsv)
                ? null
                : _allowedValuesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var request = new CreateTagDefinitionRequest
            {
                TagDefinitionKey = _key.Trim(),
                DisplayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName,
                ContentType = _contentType,
                // The list is the only choice <=> custom values are not allowed. One decision,
                // two fields (PL-23).
                AllowCustomValue = !_restrictToList,
                IsMultiValued = _isMultiValued,
                AllowedValues = allowedValues,
                RequirementLevel = _requirementLevel,
                DisplayOrder = _displayOrder
            };

            var response = await ResourceService.CreateTagDefinitionAsync(request, CancellationToken.None);
            if (response.IsSuccess() && response.ApiResponse.Data is not null)
            {
                MudDialog.Close(DialogResult.Ok(response.ApiResponse.Data));
            }
            else
            {
                _error = "Could not create tag definition.";
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
